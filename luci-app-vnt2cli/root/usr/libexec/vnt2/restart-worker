#!/bin/sh

PENDING_FILE="${VNT2_RESTART_PENDING_FILE:-/tmp/vnt2-restart.pending}"
CLAIMED_FILE="${VNT2_RESTART_CLAIMED_FILE:-/tmp/vnt2-restart.claimed}"
DOWNLOAD_LOG="${VNT2_RESTART_LOG_FILE:-/tmp/vnt2-download.log}"
RESTART_COMMAND="${VNT2_RESTART_COMMAND:-/etc/init.d/vnt2}"
NETWORK_SYNC_COMMAND="${VNT2_NETWORK_SYNC_COMMAND:-/etc/init.d/vnt2 sync_network}"
SYS_CLASS_NET="${VNT2_SYS_CLASS_NET:-/sys/class/net}"
RESTART_DELAY="${VNT2_RESTART_DELAY:-5}"
POLL_INTERVAL="${VNT2_RESTART_POLL_INTERVAL:-1}"
NETWORK_RETRY_INTERVAL="${VNT2_NETWORK_RETRY_INTERVAL:-5}"
# A restart churns network devices for a few seconds. Reconciling on every
# one of those intermediate states would reload netifd and the firewall over
# and over, so device changes are coalesced for at least this long.
NETWORK_MIN_INTERVAL="${VNT2_NETWORK_MIN_INTERVAL:-2}"
NETWORK_SNAPSHOT=""
NETWORK_SNAPSHOT_READY=0
NETWORK_SYNC_FAILED=0
NETWORK_LAST_SYNC=0

log_worker() {
	printf '%s download : %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${DOWNLOAD_LOG}"
}

read_request_time() {
	local request_time

	request_time="$(sed -n '1p' "$1" 2>/dev/null)"
	case "$request_time" in
		''|*[!0-9]*) request_time="$(date +%s)" ;;
	esac
	printf '%s\n' "$request_time"
}

claim_restart_request() {
	[ -f "$PENDING_FILE" ] || return 1
	mv -f "$PENDING_FILE" "$CLAIMED_FILE" 2>/dev/null
}

run_restart() {
	local rc

	log_worker "worker starts queued restart"
	VNT2_RESTART_MODE=apply "$RESTART_COMMAND" restart </dev/null >/dev/null 2>&1
	rc=$?
	if [ "$rc" -eq 0 ]; then
		log_worker "worker completed queued restart"
	else
		log_worker "worker restart failed rc=${rc}"
	fi
	return "$rc"
}

read_network_snapshot() {
	local name flags ifindex details address interesting bound

	# UCI is the single source of truth for the one and only client config;
	# any option change (enabled flag, client settings) triggers a network
	# reconciliation even when no device state changed.
	checksum="$(uci -q show vnt2 2>/dev/null | sort)"
	if [ -n "$checksum" ]; then
		printf 'uci %s\n' "$checksum"
	fi
	[ -d "$SYS_CLASS_NET" ] || return 0
	bound="$(uci -q get network.VNT2.device 2>/dev/null || true)"

	for dir in "$SYS_CLASS_NET"/*; do
		[ -d "$dir" ] || continue
		name="${dir##*/}"

		# Only tun/tap candidates need the iproute2 details. Inspecting every
		# interface of the router on every poll forks ip twice per device and
		# stalls the router instead of reconciling the tunnel, so the sysfs
		# attributes (read without a fork) decide who is a candidate.
		interesting=0
		case "$name" in
			tun*|tap*|vnt*) interesting=1 ;;
		esac
		[ "$name" = "$bound" ] && interesting=1

		flags=""
		if [ -r "$dir/tun_flags" ]; then
			read -r flags <"$dir/tun_flags" 2>/dev/null || flags=""
		fi
		[ -n "$flags" ] && interesting=1

		ifindex=""
		if [ -r "$dir/ifindex" ]; then
			read -r ifindex <"$dir/ifindex" 2>/dev/null || ifindex=""
		fi

		details=""
		address=""
		if [ "$interesting" -eq 1 ]; then
			if command -v ip >/dev/null 2>&1; then
				details="$(ip -d link show dev "$name" 2>/dev/null || true)"
				address="$(ip -4 -o addr show dev "$name" 2>/dev/null || true)"
			elif command -v ifconfig >/dev/null 2>&1; then
				address="$(ifconfig "$name" 2>/dev/null | sed -n '/inet /p')"
			fi
		fi

		printf 'net-device %s %s %s %s\n' "$name" "$flags" "$ifindex" "$details"
		printf 'tun-address %s %s\n' "$name" "$address"
	done
}

sync_network_if_changed() {
	local snapshot rc now elapsed

	snapshot="$(read_network_snapshot)"
	now="$(date +%s)"
	case "$NETWORK_RETRY_INTERVAL" in
		''|*[!0-9]*) NETWORK_RETRY_INTERVAL=5 ;;
	esac
	case "$NETWORK_MIN_INTERVAL" in
		''|*[!0-9]*) NETWORK_MIN_INTERVAL=2 ;;
	esac

	if [ "$NETWORK_SNAPSHOT_READY" -eq 1 ] && [ "$snapshot" = "$NETWORK_SNAPSHOT" ]; then
		if [ "$NETWORK_SYNC_FAILED" -eq 0 ]; then
			return 0
		fi
		elapsed=$((now - NETWORK_LAST_SYNC))
		[ "$elapsed" -lt "$NETWORK_RETRY_INTERVAL" ] && return 0
	else
		# Something changed: reconcile at once, but not more often than the
		# minimum interval - a restarting client churns devices for seconds
		# and every intermediate state would otherwise reload the firewall.
		elapsed=$((now - NETWORK_LAST_SYNC))
		if [ "$NETWORK_SNAPSHOT_READY" -eq 1 ] && [ "$elapsed" -lt "$NETWORK_MIN_INTERVAL" ]; then
			return 0
		fi
	fi

	NETWORK_SNAPSHOT="$snapshot"
	NETWORK_LAST_SYNC="$now"
	# shellcheck disable=SC2086
	$NETWORK_SYNC_COMMAND </dev/null >/dev/null 2>&1
	rc=$?
	if [ "$rc" -ne 0 ]; then
		NETWORK_SNAPSHOT_READY=1
		NETWORK_SYNC_FAILED=1
		log_worker "network sync failed rc=${rc}"
		return 0
	fi
	NETWORK_SNAPSHOT_READY=1
	NETWORK_SYNC_FAILED=0
	return 0
}

trap 'exit 0' INT TERM

while :; do
	sync_network_if_changed
	if [ ! -f "$CLAIMED_FILE" ]; then
		claim_restart_request || {
			sleep "$POLL_INTERVAL"
			continue
		}
	fi

	request_time="$(read_request_time "$CLAIMED_FILE")"
	now="$(date +%s)"
	age=$((now - request_time))
	if [ "$age" -le "$RESTART_DELAY" ]; then
		sleep "$POLL_INTERVAL"
		continue
	fi

	# A newer marker replaces the claimed request and restarts the debounce
	# window. This coalesces repeated Save & Apply and reload events.
	if claim_restart_request; then
		continue
	fi

	run_restart
	rm -f "$CLAIMED_FILE"
done
