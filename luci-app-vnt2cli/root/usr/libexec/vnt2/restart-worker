#!/bin/sh

PENDING_FILE="${VNT2_RESTART_PENDING_FILE:-/tmp/vnt2-restart.pending}"
CLAIMED_FILE="${VNT2_RESTART_CLAIMED_FILE:-/tmp/vnt2-restart.claimed}"
DOWNLOAD_LOG="${VNT2_RESTART_LOG_FILE:-/tmp/vnt2-download.log}"
RESTART_COMMAND="${VNT2_RESTART_COMMAND:-/etc/init.d/vnt2}"
NETWORK_CONFIG_DIR="${VNT2_NETWORK_CONFIG_DIR:-/vnt_config}"
NETWORK_SYNC_COMMAND="${VNT2_NETWORK_SYNC_COMMAND:-/etc/init.d/vnt2 sync_network}"
SYS_CLASS_NET="${VNT2_SYS_CLASS_NET:-/sys/class/net}"
RESTART_DELAY="${VNT2_RESTART_DELAY:-15}"
POLL_INTERVAL="${VNT2_RESTART_POLL_INTERVAL:-1}"
NETWORK_RETRY_INTERVAL="${VNT2_NETWORK_RETRY_INTERVAL:-5}"
NETWORK_SNAPSHOT=""
NETWORK_SNAPSHOT_READY=0
NETWORK_SYNC_FAILED=0
NETWORK_LAST_SYNC=0

log_worker() {
	printf '%s download : %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${DOWNLOAD_LOG}"
}

read_request_time() {
	local request_time

	request_time="$(sed -n '1p' "$1" 2>/dev/null)"
	case "$request_time" in
		''|*[!0-9]*) request_time="$(date +%s)" ;;
	esac
	printf '%s\n' "$request_time"
}

claim_restart_request() {
	[ -f "$PENDING_FILE" ] || return 1
	mv -f "$PENDING_FILE" "$CLAIMED_FILE" 2>/dev/null
}

run_restart() {
	local rc

	log_worker "worker starts queued restart"
	VNT2_RESTART_MODE=apply "$RESTART_COMMAND" restart </dev/null >/dev/null 2>&1
	rc=$?
	if [ "$rc" -eq 0 ]; then
		log_worker "worker completed queued restart"
	else
		log_worker "worker restart failed rc=${rc}"
	fi
	return "$rc"
}

read_network_snapshot() {
	local file name size mtime checksum dir flags address ifindex details

	if [ -d "$NETWORK_CONFIG_DIR" ]; then
		for file in "$NETWORK_CONFIG_DIR"/*.toml; do
			[ -f "$file" ] || continue
			[ -L "$file" ] && continue
			name="${file##*/}"
			size="$(stat -c '%s' "$file" 2>/dev/null || wc -c <"$file" 2>/dev/null || printf '0')"
			mtime="$(stat -c '%Y' "$file" 2>/dev/null || printf '0')"
			checksum="$(cksum <"$file" 2>/dev/null || true)"
			printf '%s %s %s %s\n' "$name" "$size" "$mtime" "$checksum"
		done
	fi
	# UCI changes (enabled flag, selected config file) must also trigger a
	# network reconciliation even when no TOML file changed.
	checksum="$(uci -q show vnt2 2>/dev/null | sort)"
	if [ -n "$checksum" ]; then
		printf 'uci %s\n' "$checksum"
	fi
	if [ -d "$SYS_CLASS_NET" ]; then
		for dir in "$SYS_CLASS_NET"/*; do
			[ -d "$dir" ] || continue
			name="${dir##*/}"
			flags="$(cat "$dir/tun_flags" 2>/dev/null || true)"
			ifindex="$(cat "$dir/ifindex" 2>/dev/null || true)"
			# Include every interface directory in the snapshot. A device may
			# appear before tun_flags is exported, and iproute2 details are the
			# fallback type signal used by the init script.
			if command -v ip >/dev/null 2>&1; then
				details="$(ip -d link show dev "$name" 2>/dev/null || true)"
			else
				details=""
			fi
			printf 'net-device %s %s %s %s\n' "$name" "$flags" "$ifindex" "$details"
			if command -v ip >/dev/null 2>&1; then
				address="$(ip -4 -o addr show dev "$name" 2>/dev/null || true)"
				printf 'tun-address %s %s\n' "$name" "$address"
			elif command -v ifconfig >/dev/null 2>&1; then
				address="$(ifconfig "$name" 2>/dev/null | sed -n '/inet /p')"
				printf 'tun-address %s %s\n' "$name" "$address"
			fi
		done
	fi
}

sync_network_if_changed() {
	local snapshot rc now elapsed

	snapshot="$(read_network_snapshot)"
	now="$(date +%s)"
	case "$NETWORK_RETRY_INTERVAL" in
		''|*[!0-9]*) NETWORK_RETRY_INTERVAL=5 ;;
	esac

	if [ "$NETWORK_SNAPSHOT_READY" -eq 1 ] && [ "$snapshot" = "$NETWORK_SNAPSHOT" ] && [ "$NETWORK_SYNC_FAILED" -eq 0 ]; then
		return 0
	fi
	if [ "$NETWORK_SNAPSHOT_READY" -eq 1 ] && [ "$snapshot" = "$NETWORK_SNAPSHOT" ] && [ "$NETWORK_SYNC_FAILED" -eq 1 ]; then
		elapsed=$((now - NETWORK_LAST_SYNC))
		[ "$elapsed" -lt "$NETWORK_RETRY_INTERVAL" ] && return 0
	fi

	NETWORK_SNAPSHOT="$snapshot"
	NETWORK_LAST_SYNC="$now"
	# shellcheck disable=SC2086
	$NETWORK_SYNC_COMMAND </dev/null >/dev/null 2>&1
	rc=$?
	if [ "$rc" -ne 0 ]; then
		NETWORK_SNAPSHOT_READY=1
		NETWORK_SYNC_FAILED=1
		log_worker "network sync failed rc=${rc}"
		return 0
	fi
	NETWORK_SNAPSHOT_READY=1
	NETWORK_SYNC_FAILED=0
	return 0
}

trap 'exit 0' INT TERM

while :; do
	sync_network_if_changed
	if [ ! -f "$CLAIMED_FILE" ]; then
		claim_restart_request || {
			sleep "$POLL_INTERVAL"
			continue
		}
	fi

	request_time="$(read_request_time "$CLAIMED_FILE")"
	now="$(date +%s)"
	age=$((now - request_time))
	if [ "$age" -le "$RESTART_DELAY" ]; then
		sleep "$POLL_INTERVAL"
		continue
	fi

	# A newer marker replaces the claimed request and restarts the debounce
	# window. This coalesces repeated Save & Apply and reload events.
	if claim_restart_request; then
		continue
	fi

	run_restart
	rm -f "$CLAIMED_FILE"
done
