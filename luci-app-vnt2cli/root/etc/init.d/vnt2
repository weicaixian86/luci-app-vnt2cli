#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
EXTRA_COMMANDS="schedule_restart sync_network"
EXTRA_HELP="\tschedule_restart\tQueue a restart for the vnt2 worker\n\tsync_network\tReconcile the VNT2 interface and firewall zone"

CONF="vnt2"

DOWNLOAD_LOG="/tmp/vnt2-download.log"

CLI_TIME="/tmp/vnt2_cli_time"

# Captures the binary's stderr (panics, early config/parse errors printed
# before log4rs initializes, and any Rust backtrace). The binary's own
# structured logs go to /tmp/logs/vnt2.log via log4rs; stdout is discarded by
# procd, so only abnormal output lands here. Surfaced in the runtime log view
# and the status page "last start error" field when the client is not running.
CLI_STDERR_LOG="/tmp/vnt2-cli-stderr.log"

# vnt2_cli (Rust/log4rs) writes its own file log to /tmp/logs/vnt2.log via a
# log4rs config it generates on first run. Its default timestamp pattern is
# RFC3339 with nanosecond precision and a zone offset
# (2026-10-07T19:19:15.844466001+08:00), which clashes with the plugin's own
# "YYYY-MM-DD HH:MM:SS" service/download log style and makes the merged runtime
# log visually inconsistent. log_init0() only writes logs/log4rs.yaml when it is
# absent, so we pre-create it with a local-time, second-precision pattern so the
# client log adopts the same format as the plugin logs.
CLIENT_LOG4RS_CONF="/tmp/logs/log4rs.yaml"

TOML_EXPORT_FILE="/tmp/vnt2cli.toml"
MACHINE_ID_FILE="/etc/machine-id"
DBUS_MACHINE_ID_FILE="/var/lib/dbus/machine-id"
# Plugin-owned proxy copy of the device identity. OpenWrt 25.x may regenerate
# /etc/machine-id at boot, so we keep our own record and restore it into
# /etc/machine-id on every start. This is a proxy consumed by the binary; the
# authoritative, upgrade-safe store is the UCI config below.
MACHINE_ID_STORE="/etc/vnt2/machine-id"
# Authoritative, upgrade-safe store. /etc/config persists across reboots AND
# sysupgrades on OpenWrt regardless of whether /etc itself is a tmpfs, so the
# device identity stays stable (9.4.1). A dedicated UCI package keeps this record
# out of the CBI map, which never touches it.
MACHINE_ID_UCI_PKG="vnt2-machine-id"
# Named UCI section. The package ships /etc/config/vnt2-machine-id with this
# section, and ensure_persistent_machine_id recreates it at runtime if the file
# is missing, so the read/write paths below always resolve.
MACHINE_ID_UCI_SEC="machine_id"

DOWNLOAD_CACHE_BASE="/tmp/vnt2-download-cache"
DOWNLOAD_CLI_STATE="/tmp/vnt2-download-cli.state"
DOWNLOAD_EVENTS="/tmp/vnt2-download.events"
VERSION_STATE_FILE="/etc/config/vnt2-cli.version"
VNT2_FIXED_REPO="vnt-dev/vnt"
VNT2_FIXED_VERSION="2.0.10"
GH_PROXY_PREFIX="https://gh-proxy.com/"
DOWNLOAD_MIRROR_RETRIES=3
RESTART_PENDING_FILE="/tmp/vnt2-restart.pending"
LAST_DEVICE_STATE_FILE="/tmp/vnt2-last-device.conf"

VNT2_FORWARD_LIST=""
NETWORK_SYNC_RESULT=""
SYS_CLASS_NET="${VNT2_SYS_CLASS_NET:-/sys/class/net}"

INSTALL_BIN_DIR="/usr/bin"
. /lib/functions.sh
. /lib/functions/procd.sh

normalize_log_text() {
	printf '%s' "$1" | tr -d '\r\000'
}

log_service() {
	local msg
	msg="$(normalize_log_text "$*")"
	printf '%s service : %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >>"${DOWNLOAD_LOG}"
}

log_download() {
	local msg
	msg="$(normalize_log_text "$*")"
	printf '%s download : %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >>"${DOWNLOAD_LOG}"
}

ensure_log_files() {
	[ -f "${DOWNLOAD_LOG}" ] || : >"${DOWNLOAD_LOG}"
}

# Seed /tmp/logs/log4rs.yaml so vnt2_cli emits the plugin's local-time,
# second-precision timestamp ("YYYY-MM-DD HH:MM:SS") instead of the log4rs
# default RFC3339-with-nanoseconds form. The binary only generates this file
# when it is missing, so writing it here takes effect on the next start. The
# pattern mirrors the binary's own default exactly, changing only {d} -> a
# strftime date format; everything else (file path, rotation, level) is kept
# identical so runtime behaviour is unchanged.
ensure_client_log_config() {
	# The binary uses log4rs, whose output level is fixed by the "root" level in
	# this YAML. log4rs does NOT read RUST_LOG, so the UCI log_level must be folded
	# into the config file itself, or every level selection is a no-op.
	local cli_log_level="$1"
	case "$cli_log_level" in
		error|warn|info|debug|trace) : ;;
		*) cli_log_level="info" ;;
	esac
	mkdir -p /tmp/logs 2>/dev/null || return 0
	local tmp="${CLIENT_LOG4RS_CONF}.$$"
	cat >"${tmp}" <<EOF
refresh_rate: 30 seconds
appenders:
  rolling_file:
    kind: rolling_file
    path: logs/vnt2.log
    append: true
    encoder:
      pattern: "{d(%Y-%m-%d %H:%M:%S)} [{f}:{L}] {h({l})} {M}:{m}{n}"
    policy:
      kind: compound
      trigger:
        kind: size
        limit: 10 mb
      roller:
        kind: fixed_window
        pattern: logs/vnt2.{}.log
        base: 1
        count: 5
  console:
    kind: console
    encoder:
      pattern: "{d(%Y-%m-%d %H:%M:%S)} {h({l})} {m}{n}"
root:
  level: ${cli_log_level}
  appenders:
    - rolling_file
    - console
EOF
	mv -f "${tmp}" "${CLIENT_LOG4RS_CONF}" 2>/dev/null || rm -f "${tmp}"
}

get_first_section_id() {
	local type="$1"
	local section=""
	config_foreach __collect_first_section "$type"
	section="$FIRST_SECTION_ID"
	FIRST_SECTION_ID=""
	echo "$section"
}

__collect_first_section() {
	local section="$1"
	[ -n "$FIRST_SECTION_ID" ] || FIRST_SECTION_ID="$section"
}

trim_value() {
	echo "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

find_firewall_zone_name() {
	local wanted_network="$1"
	local idx=0
	local fallback=""
	local zone_name network_list net

	while uci -q show "firewall.@zone[$idx]" >/dev/null 2>&1; do
		zone_name="$(trim_value "$(uci -q get "firewall.@zone[$idx].name" 2>/dev/null)")"
		network_list="$(trim_value "$(uci -q get "firewall.@zone[$idx].network" 2>/dev/null)")"

		if [ -n "$zone_name" ]; then
			[ "$zone_name" = "$wanted_network" ] && fallback="$zone_name"
			for net in $network_list; do
				[ "$net" = "$wanted_network" ] && {
					echo "$zone_name"
					return 0
				}
			done
		fi

		idx=$((idx + 1))
	done

	[ -n "$fallback" ] && {
		echo "$fallback"
		return 0
	}

	return 1
}

valid_port() {
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

sanitize_name() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
}

# ---------- UCI to runtime TOML export ----------
# /etc/config/vnt2 is the single source of truth for the one and only client
# config. The runtime TOML /tmp/vnt2cli.toml is regenerated from UCI on every
# start; hand edits to it never survive a restart.

toml_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n\000'
}

TOML_LIST_OUT=""

__toml_collect_list_item() {
	local item
	item="$(toml_escape "$1")"
	[ -n "$item" ] || return 0
	if [ -n "$TOML_LIST_OUT" ]; then
		TOML_LIST_OUT="${TOML_LIST_OUT}, \"${item}\""
	else
		TOML_LIST_OUT="\"${item}\""
	fi
}

toml_list_nonempty() {
	TOML_LIST_HAS=0
	config_list_foreach "$1" "$2" __toml_list_nonempty_cb
}

__toml_list_nonempty_cb() {
	TOML_LIST_HAS=1
}

toml_put_string() {
	local file="$1"
	local key="$2"
	local value="$3"

	[ -n "$value" ] || return 0
	printf '%s = "%s"\n' "$key" "$(toml_escape "$value")" >>"$file"
}

toml_put_bool() {
	local file="$1"
	local key="$2"
	local value="$3"

	[ -n "$value" ] || return 0
	if [ "$value" = "1" ]; then
		printf '%s = true\n' "$key" >>"$file"
	else
		printf '%s = false\n' "$key" >>"$file"
	fi
}

toml_put_number() {
	local file="$1"
	local key="$2"
	local value="$3"

	case "$value" in
		''|*[!0-9]*) return 0 ;;
	esac
	printf '%s = %s\n' "$key" "$value" >>"$file"
}

toml_put_list() {
	local file="$1"
	local key="$2"
	local section="$3"
	local option="$4"

	TOML_LIST_OUT=""
	config_list_foreach "$section" "$option" __toml_collect_list_item
	[ -n "$TOML_LIST_OUT" ] || return 0
	printf '%s = [%s]\n' "$key" "$TOML_LIST_OUT" >>"$file"
}

export_client_config() {
	local cfg="$1"
	local tmp="${TOML_EXPORT_FILE}.$$"
	local network_code subscription tunnel_port

	rm -f "$tmp"
	(umask 077; : >"$tmp") || {
		log_service 'export failed: unable to create runtime toml temporary file'
		return 1
	}

	toml_put_string "$tmp" "subscription" "$(config_get "$cfg" "subscription")"
	toml_put_list "$tmp" "server" "$cfg" "server"
	toml_put_list "$tmp" "peer_address" "$cfg" "peer_address"
	toml_put_list "$tmp" "turn" "$cfg" "turn"
	toml_put_list "$tmp" "punch_model" "$cfg" "punch_model"
	toml_put_string "$tmp" "network_code" "$(config_get "$cfg" "network_code")"
	toml_put_string "$tmp" "ip" "$(config_get "$cfg" "ip")"
	toml_put_bool "$tmp" "no_punch" "$(config_get "$cfg" "no_punch")"
	toml_put_bool "$tmp" "no_broadcast" "$(config_get "$cfg" "no_broadcast")"
	toml_put_bool "$tmp" "allow_ikev2" "$(config_get "$cfg" "allow_ikev2")"
	toml_put_bool "$tmp" "allow_wireguard" "$(config_get "$cfg" "allow_wireguard")"
	toml_put_bool "$tmp" "rtx" "$(config_get "$cfg" "rtx")"
	toml_put_bool "$tmp" "compress" "$(config_get "$cfg" "compress")"
	toml_put_bool "$tmp" "fec" "$(config_get "$cfg" "fec")"
	toml_put_list "$tmp" "input" "$cfg" "input"
	toml_put_list "$tmp" "subnet_mapping" "$cfg" "subnet_mapping"
	toml_put_list "$tmp" "output" "$cfg" "output"
	toml_put_bool "$tmp" "auto_sync_subnet" "$(config_get "$cfg" "auto_sync_subnet")"
	toml_put_bool "$tmp" "no_nat" "$(config_get "$cfg" "no_nat")"
	toml_put_string "$tmp" "device_mode" "$(config_get "$cfg" "device_mode")"
	toml_put_number "$tmp" "mtu" "$(config_get "$cfg" "mtu")"
	toml_put_list "$tmp" "port_mapping" "$cfg" "port_mapping"
	toml_put_bool "$tmp" "allow_mapping" "$(config_get "$cfg" "allow_mapping")"
	toml_put_string "$tmp" "device_id" "$(config_get "$cfg" "device_id")"
	toml_put_string "$tmp" "device_name" "$(config_get "$cfg" "device_name")"
	toml_put_string "$tmp" "tun_name" "$(config_get "$cfg" "tun_name")"
	toml_put_string "$tmp" "outbound_interface" "$(config_get "$cfg" "outbound_interface")"
	toml_put_string "$tmp" "password" "$(config_get "$cfg" "password")"
	toml_put_string "$tmp" "cert_mode" "$(config_get "$cfg" "cert_mode")"
	toml_put_list "$tmp" "udp_stun" "$cfg" "udp_stun"
	toml_put_list "$tmp" "tcp_stun" "$cfg" "tcp_stun"
	toml_put_list "$tmp" "tunnel_addr" "$cfg" "tunnel_addr"
	toml_put_number "$tmp" "tunnel_port" "$(config_get "$cfg" "tunnel_port")"
	toml_put_string "$tmp" "event_script" "$(config_get "$cfg" "event_script")"

	toml_list_nonempty "$cfg" "tunnel_addr"
	tunnel_port="$(config_get "$cfg" "tunnel_port")"
	if [ "$TOML_LIST_HAS" = "1" ] && [ -n "$tunnel_port" ]; then
		log_service 'export failed: tunnel_addr and tunnel_port are mutually exclusive'
		rm -f "$tmp"
		return 1
	fi

	network_code="$(config_get "$cfg" "network_code")"
	subscription="$(config_get "$cfg" "subscription")"
	if [ -z "$network_code" ] && [ -z "$subscription" ]; then
		# The client simply is not configured yet. That is not a start
		# failure: reporting one makes the service look broken and hands the
		# restart worker a reason to retry a start that cannot succeed until
		# the user fills in the config.
		EXPORT_NOT_CONFIGURED=1
		log_service 'export skipped: client config missing network_code and subscription'
		rm -f "$tmp"
		return 1
	fi

	chmod 600 "$tmp" >/dev/null 2>&1
	if ! mv -f "$tmp" "$TOML_EXPORT_FILE"; then
		rm -f "$tmp"
		log_service 'export failed: unable to publish runtime toml'
		return 1
	fi
	log_service "runtime toml exported: ${TOML_EXPORT_FILE}"
	return 0
}

write_download_state() {
	local state_file="$1"
	local state="$2"
	local message="$3"
	local asset="$4"
	local tag="$5"
	local arch="$6"
	local path="$7"

	message="$(normalize_log_text "$message")"

	cat >"${state_file}" <<EOF
state=${state}
message=${message}
asset=${asset}
tag=${tag}
arch=${arch}
path=${path}
time=$(date '+%Y-%m-%d %H:%M:%S')
EOF
}

normalize_state_value() {
	printf '%s' "$1" | tr -d '\r\n\000'
}

file_mtime() {
	local path="$1"

	stat -c '%Y' "$path" 2>/dev/null && return 0
	date -r "$path" +%s 2>/dev/null
}

file_size() {
	local path="$1"

	[ -f "$path" ] || return 1
	wc -c <"$path" 2>/dev/null | tr -d '[:space:]'
}

# Human-readable byte size for logs (e.g. 12.4MB).
format_size() {
	local b="$1" mb
	case "$b" in
		''|*[!0-9]*) echo "0B"; return ;;
	esac
	[ "$b" -lt 1024 ] 2>/dev/null && { echo "${b}B"; return; }
	[ "$b" -lt 1048576 ] 2>/dev/null && { echo "$((b / 1024))KB"; return; }
	mb="$(awk "BEGIN{printf \"%.1f\", $b / 1048576}")"
	[ "$b" -lt 1073741824 ] 2>/dev/null && { echo "${mb}MB"; return; }
	echo "$(awk "BEGIN{printf \"%.2f\", $b / 1073741824}")GB"
}

# Returns 0 when the filesystem holding `path` has at least `need_kb` KiB free.
check_free_space() {
	local path="$1" need_kb="$2" avail
	[ -d "$path" ] || path="$(dirname "$path" 2>/dev/null)"
	[ -n "$path" ] || return 0
	avail="$(df -k "$path" 2>/dev/null | awk 'NR==2{print $4}')"
	[ -z "$avail" ] && return 0
	[ "$avail" -ge "$need_kb" ] 2>/dev/null
}

# Detect the real container type from the leading magic bytes rather than the
# file name, so a misnamed or hand-edited archive is never unpacked with the
# wrong tool. Returns: elf | gz | zip | xz | unknown.
detect_file_magic() {
	local f="$1" magic
	[ -s "$f" ] || { echo "unknown"; return; }
	# Read 6 bytes: xz's magic is fd 37 7a 58 5a 00, so a 4-byte read can never
	# match it. elf/gz/zip magics are all <= 4 bytes and still match by prefix.
	magic="$(dd if="$f" bs=1 count=6 2>/dev/null | od -An -tx1 | tr -dc '0-9a-fA-F')"
	case "$magic" in
		7f454c46*) echo "elf" ;;
		1f8b*)     echo "gz" ;;
		504b0304*) echo "zip" ;;
		fd377a585a*) echo "xz" ;;
		*)         echo "unknown" ;;
	esac
}

# Normalize an asset to a dispatch key: magic bytes win, file extension is the
# fallback. gzip here always means a tar.gz bundle in our context.
classify_archive() {
	local f="$1" magic ext
	magic="$(detect_file_magic "$f")"
	case "$magic" in
		elf) echo "elf"; return ;;
		gz)  echo "tar.gz"; return ;;
		xz)  echo "tar.xz"; return ;;
		zip) echo "zip"; return ;;
	esac
	ext="$(printf '%s' "$f" | tr 'A-Z' 'a-z')"
	case "$ext" in
		*.zip)        echo "zip" ;;
		*.tgz|*.tar.gz) echo "tar.gz" ;;
		*.tar.xz|*.txz) echo "tar.xz" ;;
		*) echo "unknown" ;;
	esac
}

# Decompress an xz/gz stream to a plain file, trying every decompressor the
# device may provide. Some BusyBox builds ship `tar` without xz (or gzip)
# support even when a standalone xz-utils binary exists on the device, so the
# native tar flag alone is not enough. Returns 1 when no decompressor is
# available or the data is corrupt.
decompress_to_file() {
	local kind="$1" src="$2" dst="$3"

	[ -s "$src" ] || return 1
	case "$kind" in
		xz|tar.xz)
			if command -v xz >/dev/null 2>&1; then
				xz -dc "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
			if command -v xzcat >/dev/null 2>&1; then
				xzcat "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
			if command -v unxz >/dev/null 2>&1; then
				unxz -c "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
		;;
		gz|tar.gz)
			if command -v gzip >/dev/null 2>&1; then
				gzip -dc "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
			if command -v gunzip >/dev/null 2>&1; then
				gunzip -c "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
			if command -v busybox >/dev/null 2>&1; then
				busybox gunzip -c "$src" >"$dst" 2>/dev/null && [ -s "$dst" ] && return 0
			fi
		;;
	esac
	rm -f "$dst" 2>/dev/null
	return 1
}

# List the entries of a tar.gz/tar.xz archive (pass "v" as the third argument
# for the verbose listing). Tries the native tar flag first, then falls back to
# an external decompressor plus plain tar. This is what keeps .tar.xz assets
# (such as the self-fetched upx release) unpackable on minimal firmwares.
tar_list_entries() {
	local kind="$1" f="$2" verbose="${3:-}"
	local out tmp rc vopt="" flag=""

	case "$verbose" in
		v) vopt="v" ;;
	esac
	case "$kind" in
		tar.gz) flag="z" ;;
		tar.xz) flag="J" ;;
		*) return 1 ;;
	esac
	out="$(tar -t${vopt}${flag}f "$f" 2>/dev/null)" && {
		printf '%s\n' "$out"
		return 0
	}
	tmp="$(mktemp /tmp/vnt2-tl.XXXXXX)" || return 1
	if decompress_to_file "$kind" "$f" "$tmp"; then
		out="$(tar -t${vopt}f "$tmp" 2>/dev/null)"
		rc=$?
		rm -f "$tmp"
		[ "$rc" -eq 0 ] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	rm -f "$tmp"
	return 1
}

# Extract a tar.gz/tar.xz archive into dest_dir with the same fallback chain.
tar_extract_entries() {
	local kind="$1" f="$2" dest="$3"
	local tmp rc flag=""

	case "$kind" in
		tar.gz) flag="z" ;;
		tar.xz) flag="J" ;;
		*) return 1 ;;
	esac
	mkdir -p "$dest" 2>/dev/null
	if tar -x${flag}f "$f" -C "$dest" >/dev/null 2>&1; then
		return 0
	fi
	tmp="$(mktemp /tmp/vnt2-tx.XXXXXX)" || return 1
	if decompress_to_file "$kind" "$f" "$tmp"; then
		tar -xf "$tmp" -C "$dest" >/dev/null 2>&1
		rc=$?
		rm -f "$tmp"
		return $rc
	fi
	rm -f "$tmp"
	return 1
}

# Post-install sanity check: actually execute the binary and confirm it runs.
# Catches the "downloaded the right file but wrong architecture" case, where
# is_elf_binary() passes (valid ELF magic) yet the kernel rejects it at exec
# time with "Exec format error".
binary_health_check() {
	local p="$1" rc
	[ -x "$p" ] || return 1
	"$p" --version >/dev/null 2>&1
	rc=$?
	[ "$rc" -eq 0 ]
}

# Parse the running binary's self-reported version (e.g. "vnt2-cli 2.0.10").
get_installed_version() {
	local p="$1" out v
	[ -x "$p" ] || return 1
	out="$("$p" --version 2>/dev/null)"
	[ -n "$out" ] || return 1
	v="$(printf '%s' "$out" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+([-+._][A-Za-z0-9]+)*' | head -n1)"
	[ -n "$v" ] && { echo "$v"; return 0; }
	return 1
}

# Append a structured, machine-readable event for the UI status view.
log_event() {
	local name="$1" detail="$2"
	printf '%s event=%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" \
		"$(normalize_log_text "$name")" "$(normalize_log_text "$detail")" >>"${DOWNLOAD_EVENTS}"
	# Cap the event log at the most recent 200 lines so it cannot grow without
	# bound in tmpfs.
	local n
	n="$(wc -l <"${DOWNLOAD_EVENTS}" 2>/dev/null | tr -d '[:space:]')"
	[ "${n:-0}" -gt 200 ] 2>/dev/null && {
		tail -n 200 "${DOWNLOAD_EVENTS}" >"${DOWNLOAD_EVENTS}.tmp" 2>/dev/null \
			&& mv -f "${DOWNLOAD_EVENTS}.tmp" "${DOWNLOAD_EVENTS}"
	}
}

write_version_state() {
	local tag="$1"
	local source="$2"
	local arch="$3"
	local asset="$4"
	local cli_path="$5"
	local ctrl_path="$6"
	local dir tmp cli_mtime cli_size ctrl_mtime ctrl_size

	[ -n "$cli_path" ] && [ -f "$cli_path" ] || return 1
	dir="${VERSION_STATE_FILE%/*}"
	mkdir -p "$dir" >/dev/null 2>&1 || return 1
	tmp="${VERSION_STATE_FILE}.$$"
	cli_mtime="$(file_mtime "$cli_path")"
	cli_size="$(file_size "$cli_path")" || return 1
	if [ -n "$ctrl_path" ] && [ -f "$ctrl_path" ]; then
		ctrl_mtime="$(file_mtime "$ctrl_path")"
		ctrl_size="$(file_size "$ctrl_path")" || return 1
	else
		ctrl_path=""
		ctrl_mtime="0"
		ctrl_size="0"
	fi

	if ! (
		umask 077
		cat >"$tmp" <<EOF
tag=$(normalize_state_value "$tag")
source=$(normalize_state_value "$source")
arch=$(normalize_state_value "$arch")
asset=$(normalize_state_value "$asset")
cli_path=$(normalize_state_value "$cli_path")
cli_mtime=$(normalize_state_value "$cli_mtime")
cli_size=$(normalize_state_value "$cli_size")
ctrl_path=$(normalize_state_value "$ctrl_path")
ctrl_mtime=$(normalize_state_value "$ctrl_mtime")
ctrl_size=$(normalize_state_value "$ctrl_size")
time=$(date '+%Y-%m-%d %H:%M:%S')
EOF
	); then
		rm -f "$tmp"
		return 1
	fi

	chmod 600 "$tmp" >/dev/null 2>&1 || {
		rm -f "$tmp"
		return 1
	}
	mv -f "$tmp" "$VERSION_STATE_FILE" >/dev/null 2>&1 || {
		rm -f "$tmp"
		return 1
	}
	return 0
}

clear_version_state() {
	rm -f "$VERSION_STATE_FILE" "$VERSION_STATE_FILE".* >/dev/null 2>&1
}

read_version_state_value() {
	local key="$1"

	[ -f "$VERSION_STATE_FILE" ] || return 1
	sed -n "s/^${key}=//p" "$VERSION_STATE_FILE" | head -n1
}

get_version_state_tag() {
	local tag

	tag="$(read_version_state_value tag)"
	[ -n "$tag" ] || return 1
	normalize_release_tag "$tag"
}

version_state_matches_binary() {
	local path="$1"
	local prefix="$2"
	local state_path state_mtime state_size actual_mtime actual_size

	state_path="$(read_version_state_value "${prefix}_path")"
	state_mtime="$(read_version_state_value "${prefix}_mtime")"
	state_size="$(read_version_state_value "${prefix}_size")"
	[ "$state_path" = "$path" ] || return 1
	[ -n "$state_mtime" ] && [ -n "$state_size" ] || return 1
	actual_mtime="$(file_mtime "$path")" || return 1
	actual_size="$(file_size "$path")" || return 1
	[ "$actual_mtime" = "$state_mtime" ] && [ "$actual_size" = "$state_size" ]
}

fixed_binary_state_matches() {
	local path="$1"

	[ "$(get_version_state_tag 2>/dev/null)" = "$VNT2_FIXED_VERSION" ] || return 1
	version_state_matches_binary "$path" "cli"
}

ensure_exec() {
	local bin="$1"
	[ -n "$bin" ] || return 1
	[ -f "$bin" ] || return 1
	chmod 755 "$bin" >/dev/null 2>&1
	return 0
}

is_elf_binary() {
	local bin="$1"
	local magic expected

	[ -s "$bin" ] || return 1
	# BusyBox od does not support the GNU -A/-t/-N options, which made every
	# real binary look invalid on stock OpenWrt. Read the four magic bytes
	# with dd and compare against the literal ELF signature.
	magic="$(dd if="$bin" bs=1 count=4 2>/dev/null)"
	expected="$(printf '\177ELF')"
	[ "$magic" = "$expected" ]
}

ensure_elf_exec() {
	local bin="$1"

	ensure_exec "$bin" || return 1
	is_elf_binary "$bin"
}

detect_arch_name() {
	local mach package_arch arm_family arm_abi
	arm_family=""
	arm_abi=""
	mach="$(uname -m 2>/dev/null)"
	package_arch="$(opkg print-architecture 2>/dev/null | awk '$2 != "all" && $2 != "noarch" {print $2; exit}')"

	case "$mach" in
		x86_64|amd64)
			echo "x86_64"
			return 0
		;;
		aarch64|arm64)
			echo "aarch64"
			return 0
		;;
		armv7*)
			arm_family="armv7"
		;;
		armv6*|arm*)
			arm_family="arm"
		;;
		mipsel*)
			echo "mipsel"
			return 0
		;;
		mips*)
			detect_mips_endian
			return 0
		;;
	esac

	if [ -n "$arm_family" ]; then
		# Prefer an ELF-header probe of the running system (reads e_flags to
		# tell hard-float musleabihf from soft-float musleabi). This mirrors the
		# endian probe used for MIPS and is robust even when the musl loader
		# symlinks are absent. Loader symlinks / package arch are used only as
		# fallbacks when the ELF probe cannot decide.
		arm_abi="$(detect_arm_float)"
		[ -z "$arm_abi" ] && {
			if [ -e /lib/ld-musl-armhf.so.1 ] || [ -e /lib/ld-musl-armhf.so.1.* ]; then
				arm_abi="musleabihf"
			elif [ -e /lib/ld-musl-arm.so.1 ] || [ -e /lib/ld-musl-arm.so.1.* ]; then
				arm_abi="musleabi"
			else
				case "$package_arch" in
					*eabihf*|*hard*|*hf*|*neon*|*vfp*) arm_abi="musleabihf" ;;
					*eabi*|*soft*) arm_abi="musleabi" ;;
					*) arm_abi="" ;;
				esac
			fi
		}
		[ -n "$arm_abi" ] && {
			echo "${arm_family}-${arm_abi}"
			return 0
		}
		echo "unsupported"
		return 0
	fi

	case "$package_arch" in
		*x86_64*|*amd64*)
			echo "x86_64"
		;;
		*aarch64*|*arm64*)
			echo "aarch64"
		;;
		*mipsel*)
			echo "mipsel"
		;;
		*mips*)
			detect_mips_endian
		;;
		*)
			echo "unsupported"
		;;
	esac
}

# --- VNT2 enhanced helpers: endian-aware MIPS, SHA256, regex arch match, deps ---

# Decide between big-endian mips and little-endian mipsel by reading the ELF
# EI_DATA byte (offset 5) of the running interpreter at /proc/self/exe. On
# ath79 (AR9331 etc.) `uname -m` reports "mips" for both, so uname alone is
# not enough. 1 = little-endian (mipsel), 2 = big-endian (mips).
detect_mips_endian() {
	local ei_data
	ei_data="$(dd if=/proc/self/exe bs=1 skip=5 count=1 2>/dev/null)"
	if [ "$ei_data" = "$(printf '\001')" ]; then
		echo "mipsel"
	else
		echo "mips"
	fi
}

# Read the 32-bit little-endian e_flags field (ELF header, offset 24) of an ELF
# file and print it as a decimal integer. Portable: reads four bytes with dd and
# decodes each with `od -An -tx1` (a format busybox od supports). Falls back to
# 0 if the file is unreadable or not a valid ELF.
read_elf_eflags_le() {
	local f="$1" b0 b1 b2 b3 v
	[ -r "$f" ] || { echo 0; return; }
	is_elf_binary "$f" >/dev/null 2>&1 || { echo 0; return; }
	b0="$(dd if="$f" bs=1 skip=24 count=1 2>/dev/null | od -An -tx1 | tr -dc '0-9a-fA-F')"
	b1="$(dd if="$f" bs=1 skip=25 count=1 2>/dev/null | od -An -tx1 | tr -dc '0-9a-fA-F')"
	b2="$(dd if="$f" bs=1 skip=26 count=1 2>/dev/null | od -An -tx1 | tr -dc '0-9a-fA-F')"
	b3="$(dd if="$f" bs=1 skip=27 count=1 2>/dev/null | od -An -tx1 | tr -dc '0-9a-fA-F')"
	b0="${b0:-0}"; b1="${b1:-0}"; b2="${b2:-0}"; b3="${b3:-0}"
	[ -z "${b0}${b1}${b2}${b3}" ] && { echo 0; return; }
	v=$(( 0x$b0 + (0x$b1 << 8) + (0x$b2 << 16) + (0x$b3 << 24) ))
	echo "$v"
}

# Decide the ARM float ABI by inspecting the ELF e_flags of a binary on the
# running system. EF_ARM_ABI_FLOAT_HARD (bit 10, 0x400) => musleabihf;
# EF_ARM_ABI_FLOAT_SOFT (bit 9, 0x200) => musleabi. The low 4 bits of e_flags
# are the EABI version; for legacy (non-EABI) ELF the float bits are not
# meaningful, so we return empty and let callers fall back. This is the ARM
# analogue of the endian probe used for MIPS.
detect_arm_float() {
	local f flags eabi
	for f in /proc/self/exe /bin/busybox /lib/libc.so* /bin/sh /sbin/init /bin/ash /lib/ld-musl-arm*.so.1; do
		[ -r "$f" ] || continue
		flags="$(read_elf_eflags_le "$f")"
		# EABI version lives in the top byte (bits 24-27, EF_ARM_EABIMASK);
		# for legacy (non-EABI) ELF the float bits are not meaningful.
		eabi=$(( (flags >> 24) & 0xFF ))
		[ "$eabi" -ge 1 ] || continue
		if [ $((flags & 0x400)) -ne 0 ]; then
			echo "musleabihf"; return 0
		elif [ $((flags & 0x200)) -ne 0 ]; then
			echo "musleabi"; return 0
		fi
	done
	echo ""
}

sha256_of() {
	local f="$1"
	[ -s "$f" ] || return 1
	command -v sha256sum >/dev/null 2>&1 || return 1
	sha256sum "$f" 2>/dev/null | awk '{print $1}'
}

arch_primary_token() {
	case "$1" in
		armv7-*) echo "armv7" ;;
		arm-*)   echo "arm" ;;
		*)       echo "$1" ;;
	esac
}

arch_token_regex() {
	# Match the architecture as a standalone word, bounded by - _ . or the
	# string edge, so "mipsel" never accidentally matches a "mips" asset and
	# vice-versa. This makes asset selection fault-tolerant to minor naming.
	local token="$1"
	printf '(^|[-_.])%s([-_.]|$)' "$token"
}

release_checksum_asset_url() {
	local json_file="$1"
	local asset_name="$2"
	local base urls url fn
	base="${asset_name%.zip}"
	[ "$base" = "$asset_name" ] && base="${asset_name%.tar.gz}"
	[ "$base" = "$asset_name" ] && base="${asset_name%.tgz}"
	urls="$(extract_release_urls "$json_file")"
	[ -n "$urls" ] || return 1
	while IFS= read -r url; do
		[ -n "$url" ] || continue
		fn="${url##*/}"
		fn="${fn%%\?*}"
		case "$fn" in
			"${asset_name}.sha256"|"${asset_name}.sha512"|"${base}.sha256"|"${base}.sha512"|"sha256.txt"|"checksums.txt"|"checksum.txt"|"SHA256SUMS")
				echo "$url"
				return 0
				;;
		esac
	done <<EOF
$urls
EOF
	return 1
}

fetch_release_sha256() {
	local checksum_url="$1"
	local asset_name="$2"
	local tmp sum
	tmp="$(mktemp "${TMPDIR:-/tmp}/vnt2sum.XXXXXX" 2>/dev/null)" || return 1
	if download_file "$checksum_url" "$tmp" "checksum" "auto"; then
		sum="$(grep -E "$asset_name" "$tmp" 2>/dev/null | grep -Eo '[0-9a-fA-F]{64}' | head -n1)"
		[ -z "$sum" ] && sum="$(grep -Eo '[0-9a-fA-F]{64}' "$tmp" 2>/dev/null | head -n1)"
	fi
	rm -f "$tmp"
	[ -n "$sum" ] && echo "$sum"
}

fetch_content_length() {
	local url="$1" dl="$2" len
	[ "$dl" = "curl" ] || { echo "0"; return 0; }
	len="$(curl -sI --connect-timeout 8 --max-time 15 "$url" 2>/dev/null | tr -d '\r' | awk -F': ' 'tolower($1)=="content-length"{print $2}' | tail -1)"
	[ -n "$len" ] && echo "$len" || echo "0"
	return 0
}

have_pkg_mgr() {
	command -v apk  >/dev/null 2>&1 && { echo apk;  return; }
	command -v opkg >/dev/null 2>&1 && { echo opkg; return; }
	echo ""
}

pm_install_pkg() {
	local pkg="$1" pm out rc=0 pid watch
	pm="$(have_pkg_mgr)"
	[ -n "$pm" ] || return 1
	command -v "$pkg" >/dev/null 2>&1 && return 0
	out="$DOWNLOAD_LOG"
	# Best-effort install with a hard watchdog so a missing package feed can
	# never hang the service start. Prefer coreutils `timeout`, else fall back
	# to a manual sleep/kill watchdog.
	if command -v timeout >/dev/null 2>&1; then
		timeout 120 "$pm" update >/dev/null 2>&1
		case "$pm" in
			apk)  timeout 180 "$pm" add "$pkg" >>"$out" 2>&1 || rc=$? ;;
			opkg) timeout 180 "$pm" install "$pkg" >>"$out" 2>&1 || rc=$? ;;
		esac
	else
		( "$pm" update >/dev/null 2>&1 ) &
		pid=$!; ( sleep 120; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & watch=$!
		wait "$pid" 2>/dev/null; kill "$watch" 2>/dev/null
		case "$pm" in
			apk)  ( "$pm" add "$pkg" >>"$out" 2>&1 ) & ;;
			opkg) ( "$pm" install "$pkg" >>"$out" 2>&1 ) & ;;
		esac
		pid=$!; ( sleep 180; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & watch=$!
		wait "$pid" 2>/dev/null; rc=$?; kill "$watch" 2>/dev/null
	fi
	command -v "$pkg" >/dev/null 2>&1
}

ensure_runtime_deps() {
	local want_upx="$1"
	# curl is the preferred downloader (it is already a hard package dependency,
	# but we install it here too as a safety net after an accidental removal or
	# a broken initial feed). wget covers devices where curl is unavailable.
	command -v curl >/dev/null 2>&1 || pm_install_pkg curl >/dev/null 2>&1 || \
		log_download "runtime install of curl failed or unavailable"
	command -v wget >/dev/null 2>&1 || pm_install_pkg wget >/dev/null 2>&1 || \
		log_download "runtime install of wget failed or unavailable"
	pm_install_pkg unzip >/dev/null 2>&1 || log_download "runtime install of unzip failed or unavailable"
	[ "$want_upx" = "1" ] && {
		# x86_64: the package bundles a static upx at /usr/bin/upx, already on
		# PATH and needs no download. On any other architecture ensure_upx_binary()
		# asks the distro package manager (apk/opkg) for the correct-arch upx —
		# both paths need no xz, so xz is intentionally NOT installed here.
		# NOTE: we health-check upx (upx_is_usable), not just `command -v upx`.
		# On a non-x86_64 device the bundled x86_64 binary is still on PATH but
		# cannot exec, so a bare `command -v` would short-circuit and leave
		# compression silently broken (Exec format error at compress time).
		if upx_is_usable; then
			: # upx already available AND runs on this arch
		elif ensure_upx_binary; then
			log_download "upx 已自动安装（包管理器）"
		else
			log_download "upx 不可用，将安装未压缩版本（功能不受影响）"
		fi
	}
}

# True only when an upx binary is on PATH AND it actually executes on this
# device. The package bundles a static x86_64 upx for the common x86_64 case,
# but on a non-x86_64 device `command -v upx` would still find that bundled
# (wrong-arch) binary; we must exec-check it so the correct arch is fetched
# instead of silently failing compression later with Exec format error.
upx_is_usable() {
	local p
	p="$(command -v upx 2>/dev/null)"
	[ -n "$p" ] && binary_health_check "$p"
}

# Returns 0 iff the file at $1 is a UPX-packed ELF. Prefers `upx -t` (authoritative)
# when upx is usable; falls back to scanning for the "UPX!" packer signature so a
# compressed binary is still detected even if upx was later removed from the system.
is_upx_compressed() {
	local f="$1"
	[ -f "$f" ] || return 1
	if upx_is_usable; then
		upx -t "$f" >/dev/null 2>&1 && return 0
	fi
	# Fallback signature scan (BusyBox grep -a reads binary content).
	grep -aq 'UPX!' "$f" 2>/dev/null && return 0
	return 1
}

# Reconcile the on-disk binary's compression state with the user's setting so that
# toggling "启用 UPX 压缩" actually takes effect without a manual reinstall:
#   - compression OFF but a binary is currently UPX-packed  -> delete it so the
#     download path below re-fetches the UNCOMPRESSED original.
#   - compression ON  but a binary is uncompressed AND upx is usable -> delete it
#     so the download path re-fetches and compresses. (Guarded by upx availability
#     to avoid re-downloading in a loop when upx cannot be obtained on this arch.)
# Deleting the files simply defeats the "skip-download" gate (which only checks for
# the binaries' presence); the subsequent download reinstalls them in the desired form.
reconcile_upx_state() {
	local want_compress="$1"
	local cli="${INSTALL_BIN_DIR}/vnt2_cli"
	local ctrl="${INSTALL_BIN_DIR}/vnt2_ctrl"
	local cli_c ctrl_c
	cli_c=0; ctrl_c=0
	[ -f "$cli" ]  && is_upx_compressed "$cli"  && cli_c=1
	[ -f "$ctrl" ] && is_upx_compressed "$ctrl" && ctrl_c=1

	if [ "$want_compress" = "1" ]; then
		if { [ -f "$cli" ]  && [ "$cli_c"  = "0" ]; } || \
		   { [ -f "$ctrl" ] && [ "$ctrl_c" = "0" ]; }; then
			# Only re-fetch when we can actually compress; otherwise we would
			# delete+redownload+stay-uncompressed on every download action.
			upx_is_usable || return 0
			log_download "压缩已启用但现有程序未压缩，将重新下载并压缩"
			rm -f "$cli" "$ctrl" 2>/dev/null
		fi
	else
		if [ "$cli_c" = "1" ] || [ "$ctrl_c" = "1" ]; then
			log_download "压缩已关闭但现有程序仍为压缩版，将删除并重新下载未压缩程序"
			rm -f "$cli" "$ctrl" 2>/dev/null
		fi
	fi
}

# Path B (borrowed from luci-app-vnt2 1.7.2's pm_install idiom): make `upx`
# available on THIS architecture by letting the distribution's package manager
# install it — `apk add upx` on iStoreOS/Alpine, `opkg install upx` on OpenWrt.
# Unlike hand-scraping a release mirror, the PM resolves the correct arch+libc
# automatically, so aarch64/armv7/x86 all get a working upx with no per-arch
# code. The bundled static x86_64 upx (fast/offline path for x86_64) is checked
# first via upx_is_usable(); we only reach the PM path on a non-x86_64 device
# (or when the bundle is absent). On any failure we return 1 so the caller's UPX
# branch (which only runs when upx_is_usable succeeds) installs the uncompressed
# binary instead. The installed upx persists in overlay, fetched at most once.
ensure_upx_binary() {
	# Health-check, not a bare `command -v`: the bundled x86_64 upx is on PATH
	# on every arch (the package is PKGARCH:=all), but it cannot exec on a
	# non-x86_64 device. Treat only a running upx as "available".
	upx_is_usable && return 0

	# Let the distro provide upx for the current arch. pm_install_pkg resolves
	# apk/opkg, is a no-op if upx is already present, and returns 0 only when
	# `upx` ends up on PATH.
	if pm_install_pkg upx >/dev/null 2>&1 && upx_is_usable; then
		log_download "已通过包管理器安装 upx ($(upx --version 2>/dev/null | head -n1))"
		log_event "upx_installed" "method=pm"
		return 0
	fi

	# Unsupported/no-upx-feed: drop the dead bundled x86_64 binary (if present)
	# so it does not masquerade as a working upx, then fall back to uncompressed.
	[ "$(command -v upx 2>/dev/null)" = "/usr/bin/upx" ] && rm -f /usr/bin/upx 2>/dev/null
	log_download "无法通过包管理器获取 upx，将安装未压缩版本"
	return 1
}

get_downloader() {
	local purpose="$1"

	case "$purpose" in
		asset)
			if command -v curl >/dev/null 2>&1; then
				echo "curl"
				return 0
			fi
			if command -v wget >/dev/null 2>&1; then
				echo "wget"
				return 0
			fi
			if command -v uclient-fetch >/dev/null 2>&1; then
				echo "uclient-fetch"
				return 0
			fi
		;;
		*)
			if command -v curl >/dev/null 2>&1; then
				echo "curl"
				return 0
			fi
			if command -v uclient-fetch >/dev/null 2>&1; then
				echo "uclient-fetch"
				return 0
			fi
			if command -v wget >/dev/null 2>&1; then
				echo "wget"
				return 0
			fi
		;;
	esac

	return 1
}

download_file() {
	local url="$1"
	local out="$2"
	local purpose="${3:-generic}"
	local mirror="${4:-auto}"
	local custom_mirror_url="$5"
	local downloader
	local rc
	local actual_url
	local timeout_cmd=""
	local connect_timeout=20
	local transfer_timeout=180
	local prog_pid="" total_bytes

	if [ "$purpose" = "api" ]; then
		connect_timeout=10
		transfer_timeout=30
	fi

	downloader="$(get_downloader "$purpose")" || return 1
	DOWNLOAD_LAST_TOOL="$downloader"
	DOWNLOAD_LAST_URL=""
	DOWNLOAD_LAST_RC=""
	DOWNLOAD_LAST_BYTES="0"
	if command -v timeout >/dev/null 2>&1; then
		timeout_cmd="$(command -v timeout)"
	fi

	for actual_url in $(get_download_url_candidates_for_mirror "$url" "$mirror" "$custom_mirror_url"); do
		DOWNLOAD_LAST_URL="$actual_url"

		# Best-effort total size for percentage reporting.
		total_bytes="0"
		if [ "$purpose" = "asset" ] || [ "$purpose" = "checksum" ]; then
			total_bytes="$(fetch_content_length "$actual_url" "$downloader")"
		fi

		# Background progress watcher: poll the partial file and log a percentage
		# (or byte count when the size is unknown) so large downloads are visible.
		prog_pid=""
		if [ "$purpose" = "asset" ] || [ "$purpose" = "checksum" ]; then
			(
				i=0
				while [ $i -lt 200 ]; do
					i=$((i + 1))
					sleep 2
					[ -f "$out" ] || continue
					cur="$(wc -c <"$out" 2>/dev/null | tr -d '[:space:]')"
					[ -n "$cur" ] || cur=0
					if [ "$total_bytes" -gt 0 ] 2>/dev/null; then
						pct=$(( cur * 100 / total_bytes ))
						[ "$pct" -gt 100 ] && pct=100
						log_download "下载进度 ${pct}% ($(format_size "$cur")/$(format_size "$total_bytes")) 镜像=${actual_url}"
					else
						log_download "下载进度 $(format_size "$cur") 镜像=${actual_url}"
					fi
				done
			) &
			prog_pid=$!
		fi

		case "$downloader" in
			curl)
				curl -fsSL --connect-timeout "$connect_timeout" --max-time "$transfer_timeout" --retry 2 --retry-delay 5 \
					-A "luci-app-vnt2cli" \
					-H "Accept: application/vnd.github+json, application/octet-stream, */*" \
					-o "$out" "$actual_url" >/dev/null 2>&1
				rc=$?
			;;
			wget)
				if [ -n "$timeout_cmd" ]; then
					"$timeout_cmd" "$transfer_timeout" wget -q --timeout="$transfer_timeout" --tries=2 \
						--header="User-Agent: luci-app-vnt2cli" \
						--header="Accept: application/vnd.github+json, application/octet-stream, */*" \
						-O "$out" "$actual_url" >/dev/null 2>&1
				else
					wget -q --timeout="$transfer_timeout" --tries=2 \
						--header="User-Agent: luci-app-vnt2cli" \
						--header="Accept: application/vnd.github+json, application/octet-stream, */*" \
						-O "$out" "$actual_url" >/dev/null 2>&1
				fi
				rc=$?
			;;
			uclient-fetch)
				if [ -n "$timeout_cmd" ]; then
					"$timeout_cmd" "$transfer_timeout" uclient-fetch -q -T "$transfer_timeout" \
						--header "User-Agent: luci-app-vnt2cli" \
						--header "Accept: application/vnd.github+json, application/octet-stream, */*" \
						-O "$out" "$actual_url" >/dev/null 2>&1
				else
					uclient-fetch -q -T "$transfer_timeout" \
						--header "User-Agent: luci-app-vnt2cli" \
						--header "Accept: application/vnd.github+json, application/octet-stream, */*" \
						-O "$out" "$actual_url" >/dev/null 2>&1
				fi
				rc=$?
			;;
			*)
				return 1
			;;
		esac

		if [ -n "$prog_pid" ]; then
			kill "$prog_pid" 2>/dev/null
			wait "$prog_pid" 2>/dev/null
		fi

		DOWNLOAD_LAST_RC="$rc"
		[ "$rc" -eq 0 ] && return 0
		DOWNLOAD_LAST_BYTES="$(wc -c <"$out" 2>/dev/null | tr -d '[:space:]')"
		[ -n "$DOWNLOAD_LAST_BYTES" ] || DOWNLOAD_LAST_BYTES="0"
		# A failed downloader may leave a partial file behind.
		rm -f "$out"
	done

	return 1
}

strip_github_proxy_url() {
	local url="$1"

	url="$(trim_value "$url")"
	case "$url" in
		${GH_PROXY_PREFIX}*)
			echo "${url#${GH_PROXY_PREFIX}}"
		;;
		*)
			echo "$url"
		;;
	esac
}

is_github_download_url() {
	case "$1" in
		https://api.github.com/*|https://github.com/*|https://raw.githubusercontent.com/*|https://objects.githubusercontent.com/*|https://release-assets.githubusercontent.com/*)
			return 0
		;;
		*)
			return 1
		;;
	esac
}

get_download_url_candidates_for_mirror() {
	local url="$1"
	local mirror="$2"
	local custom_mirror_url="$3"
	local raw_url

	url="$(trim_value "$url")"
	raw_url="$(strip_github_proxy_url "$url")"
	mirror="$(normalize_download_mirror "$mirror")"
	custom_mirror_url="$(normalize_custom_mirror_url "$custom_mirror_url")"
	[ -n "$raw_url" ] || return 0

	if [ "$mirror" = "github" ]; then
		printf '%s\n' "$raw_url"
	elif [ "$mirror" = "gh-proxy" ] && is_github_download_url "$raw_url"; then
		printf '%s\n' "${GH_PROXY_PREFIX}${raw_url}"
	elif [ "$mirror" = "custom" ] && [ -n "$custom_mirror_url" ] && is_github_download_url "$raw_url"; then
		printf '%s\n' "${custom_mirror_url}${raw_url}"
		printf '%s\n' "$raw_url"
	else
		# A selected mirror must not silently fall back to gh-proxy. The outer
		# mirror loop owns source failover and retry counting.
		printf '%s\n' "$raw_url"
	fi
}

normalize_custom_mirror_url() {
	local url="$1"

	url="$(trim_value "$url")"
	[ -n "$url" ] || return 0
	case "$url" in
		http://*|https://*) ;;
		*) return 0 ;;
	esac
	printf '%s\n' "$url" | sed 's#/*$#/#'
}

normalize_release_tag() {
	local tag="$1"
	tag="$(trim_value "$tag")"
	tag="${tag#v}"
	tag="${tag#V}"
	echo "$tag"
}

normalize_download_mirror() {
	local mirror="$1"

	mirror="$(trim_value "$mirror" | tr 'A-Z' 'a-z')"
	case "$mirror" in
		auto|cn|china|domestic|''|gh-proxy|ghproxy|proxy)
		if [ "$mirror" = "gh-proxy" ] || [ "$mirror" = "ghproxy" ] || [ "$mirror" = "proxy" ]; then
			echo "gh-proxy"
		else
			echo "auto"
		fi
		;;
		github)
			echo "github"
		;;
		custom)
			echo "custom"
		;;
		gitee|gitlab|cloudflare)
			echo "$mirror"
		;;
		*)
			echo "auto"
		;;
	esac
}

repo_to_mirror_project() {
	local repo="$1"

	repo="$(trim_value "$repo")"
	case "$repo" in
		vnt-dev/vnt)
			echo "vnt"
			return 0
		;;
	esac

	return 1
}

select_download_mirror() {
	local repo="$1"
	local mirror="$2"
	local candidate

	for candidate in $(get_download_mirror_candidates "$repo" "$mirror"); do
		echo "$candidate"
		return 0
	done

	echo "github"
}

get_download_mirror_candidates() {
	local repo="$1"
	local mirror="$2"

	[ -n "$repo" ] || repo="vnt-dev/vnt"
	mirror="$(normalize_download_mirror "$mirror")"

	case "$mirror" in
		auto)
			printf '%s\n' "gh-proxy" "github" "gitee" "gitlab" "cloudflare"
		;;
		gh-proxy)
			printf '%s\n' "gh-proxy" "github"
		;;
		github)
			echo "github"
		;;
		custom)
			printf '%s\n' "custom" "github"
		;;
		gitee|gitlab|cloudflare)
			printf '%s\n' "$mirror" "github"
		;;
		*)
			printf '%s\n' "gh-proxy" "github"
		;;
	esac
}

get_download_mirror_cache_key() {
	local repo="$1"
	local mirror="$2"
	local custom_mirror_url="$3"

	mirror="$(normalize_download_mirror "$mirror")"
	case "$mirror" in
		auto)
			echo "auto"
		;;
		gh-proxy)
			echo "gh-proxy"
		;;
		github)
			echo "github"
		;;
		custom)
			custom_mirror_url="$(normalize_custom_mirror_url "$custom_mirror_url")"
			if [ -n "$custom_mirror_url" ]; then
				echo "custom_$(sanitize_name "$custom_mirror_url")"
			else
				echo "custom"
			fi
		;;
		gitee|gitlab|cloudflare)
			echo "$mirror"
		;;
		*)
			echo "$mirror"
		;;
	esac
}

get_release_api_candidates() {
	local repo="$1"
	local tag="$2"
	local mirror="$3"
	local normalized_tag effective_mirror project

	[ "$repo" = "$VNT2_FIXED_REPO" ] || return 1
	normalized_tag="$(normalize_release_tag "$tag")"
	[ "$normalized_tag" = "$VNT2_FIXED_VERSION" ] || return 1
	effective_mirror="$(select_download_mirror "$repo" "$mirror")"

	case "$effective_mirror" in
		gitee|gitlab|cloudflare)
			project="$(repo_to_mirror_project "$repo")" || effective_mirror="github"
			if [ "$effective_mirror" != "github" ]; then
				case "$effective_mirror" in
					gitee)
						echo "https://gitee.com/api/v5/repos/whzhni/${project}/releases"
					;;
					gitlab)
						echo "https://gitlab.com/api/v4/projects/whzhni%2F${project}/releases"
					;;
					cloudflare)
						echo "https://pub-8a57d35d70d5423aac22a3316867e7ce.r2.dev/${project}/releases"
					;;
				 esac
				return 0
			fi
		;;
	esac

	echo "https://api.github.com/repos/${repo}/releases/tags/${normalized_tag}"
	echo "https://api.github.com/repos/${repo}/releases/tags/v${normalized_tag}"
}

extract_release_urls() {
	local json_file="$1"

	grep -o 'https://[^"]*' "$json_file" 2>/dev/null | \
		sed 's#\\/#/#g' | awk 'NF && !seen[$0]++'
}

extract_release_object_by_tag() {
	local src="$1"
	local dst="$2"
	local wanted_tag="$3"

	awk -v wanted="$wanted_tag" '
BEGIN {
	sub(/^[vV]/, "", wanted)
	in_array = 0
	depth = 0
	started = 0
	in_string = 0
	escaped = 0
	out = ""
}
{
	line = $0
	if (!in_array) {
		pos = index(line, "[")
		if (pos > 0) {
			in_array = 1
			line = substr(line, pos + 1)
		} else {
			next
		}
	}
	for (i = 1; i <= length(line); i++) {
		c = substr(line, i, 1)
		if (!started) {
			if (c == "{") {
				started = 1
				depth = 1
				out = "{"
			}
			continue
		}
		out = out c
		if (in_string) {
			if (escaped) {
				escaped = 0
			} else if (c == "\\") {
				escaped = 1
			} else if (c == "\"") {
				in_string = 0
			}
			continue
		}
		if (c == "\"") {
			in_string = 1
		} else if (c == "{") {
			depth++
		} else if (c == "}") {
			depth--
			if (depth == 0) {
				tag = out
				if (sub(/^.*"tag_name"[[:space:]]*:[[:space:]]*"/, "", tag)) {
					sub(/".*$/, "", tag)
					sub(/^[vV]/, "", tag)
				}
				if (tag == wanted) {
					print out
					exit
				}
				started = 0
				in_string = 0
				escaped = 0
				out = ""
			}
		}
	}
}
' "$src" >"$dst"

	[ -s "$dst" ]
}

fetch_release_metadata_from_mirror() {
	local repo="$1"
	local tag="$2"
	local json_file="$3"
	local mirror="$4"
	local custom_mirror_url="$5"
	local api_url response_tag candidate requested_tag effective_mirror tagged_file json_root

	[ "$repo" = "$VNT2_FIXED_REPO" ] || return 1
	[ "$(normalize_release_tag "$tag")" = "$VNT2_FIXED_VERSION" ] || return 1
	effective_mirror="$(select_download_mirror "$repo" "$mirror")"
	requested_tag="$(normalize_release_tag "$tag")"

	for candidate in $(get_release_api_candidates "$repo" "$tag" "$effective_mirror"); do
		log_download "checking release endpoint: ${candidate}"
		if download_file "$candidate" "$json_file" "api" "$effective_mirror" "$custom_mirror_url"; then
			response_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n1)"
			response_tag="$(normalize_release_tag "$response_tag")"
			case "$candidate" in
				*/releases)
						json_root="$(sed -n 's/^[[:space:]]*\([{[]\).*/\1/p' "$json_file" | head -n1)"
						if [ "$json_root" = "[" ] && [ -n "$requested_tag" ]; then
							tagged_file="${json_file}.tagged"
							if extract_release_object_by_tag "$json_file" "$tagged_file" "$requested_tag"; then
								mv -f "$tagged_file" "$json_file"
							else
								rm -f "$tagged_file"
								continue
							fi
						fi
					if [ -s "$json_file" ]; then
						response_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n1)"
						response_tag="$(normalize_release_tag "$response_tag")"
					fi
				;;
			esac
			if [ "$response_tag" = "$VNT2_FIXED_VERSION" ]; then
				echo "$candidate"
				return 0
			fi
		fi
	done

	return 1
}

get_release_asset_name_candidates() {
	local scope="$1"
	local version="$2"
	local arch_name="$3"
	local prefix suffix

	version="$(normalize_release_tag "$version")"
	[ "$version" = "$VNT2_FIXED_VERSION" ] || return 1

	case "$scope" in
		cli)
			prefix="vnt2"
			suffix=".zip"
		;;
		*)
			return 1
		;;
	esac

	case "$arch_name" in
		x86_64)
			echo "${prefix}-x86_64-unknown-linux-musl-v${version}${suffix}"
		;;
		aarch64)
			echo "${prefix}-aarch64-unknown-linux-musl-v${version}${suffix}"
		;;
		armv7-musleabihf)
			echo "${prefix}-armv7-unknown-linux-musleabihf-v${version}${suffix}"
		;;
		armv7-musleabi)
			echo "${prefix}-armv7-unknown-linux-musleabi-v${version}${suffix}"
		;;
		arm-musleabihf)
			echo "${prefix}-arm-unknown-linux-musleabihf-v${version}${suffix}"
		;;
		arm-musleabi)
			echo "${prefix}-arm-unknown-linux-musleabi-v${version}${suffix}"
		;;
		mipsel)
			echo "${prefix}-mipsel-unknown-linux-musl-v${version}${suffix}"
		;;
		mips)
			echo "${prefix}-mips-unknown-linux-musl-v${version}${suffix}"
		;;
		*)
			return 1
		;;
	esac
}

get_release_asset_url() {
	local repo="$1"
	local scope="$2"
	local version="$3"
	local arch_name="$4"
	local asset_name

	[ "$repo" = "$VNT2_FIXED_REPO" ] || return 1
	[ "$(normalize_release_tag "$version")" = "$VNT2_FIXED_VERSION" ] || return 1
	asset_name="$(get_release_asset_name_candidates "$scope" "$version" "$arch_name" | head -n1)"
	[ -n "$asset_name" ] || return 1
	echo "https://github.com/${repo}/releases/download/v${version}/${asset_name}"
}

select_release_asset() {
	local json_file="$1"
	local scope="$2"
	local version="$3"
	local arch_name="$4"
	local urls url filename arch_token arch_pat abi_token

	urls="$(extract_release_urls "$json_file")"
	[ -n "$urls" ] || return 1

	# Match by architecture token instead of an exact filename, so minor
	# upstream naming variations (order of components, extra suffixes) still
	# resolve. Checksum / metadata assets are skipped. For ARM we additionally
	# require the float-ABI token (musleabihf vs musleabi) so the wrong float
	# variant is never selected.
	arch_token="$(arch_primary_token "$arch_name")"
	arch_pat="$(arch_token_regex "$arch_token")"
	case "$arch_name" in
		*musleabihf*) abi_token="musleabihf" ;;
		*musleabi*)    abi_token="musleabi" ;;
	esac
	[ -n "$arch_pat" ] || return 1

	while IFS= read -r url; do
		[ -n "$url" ] || continue
		filename="${url##*/}"
		filename="${filename%%\?*}"
		case "$filename" in
			*.sha256|*.sha512|*.md5|*.txt|*checksum*|*.sig|*.asc)
				continue
				;;
		esac
		echo "$filename" | grep -Eq -- "$arch_pat" || continue
		if [ -n "$abi_token" ]; then
			echo "$filename" | grep -Eq -- "$(arch_token_regex "$abi_token")" || continue
		fi
		echo "$url"
		return 0
	done <<EOF
$urls
EOF

	return 1
}

extract_zip_asset() {
	local asset_file="$1"
	local dest_dir="$2"

	if command -v unzip >/dev/null 2>&1; then
		unzip -qo "$asset_file" -d "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if command -v busybox >/dev/null 2>&1; then
		busybox unzip -o "$asset_file" -d "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if command -v bsdtar >/dev/null 2>&1; then
		bsdtar -xf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if tar -tf "$asset_file" >/dev/null 2>&1; then
		tar -xf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	return 1
}

archive_paths_are_safe() {
	awk '
BEGIN { bad = 0 }
{
	entry = $0
	gsub(/\\/, "/", entry)
	sub(/^\.\//, "", entry)
	if (entry ~ /^\// || entry ~ /^[A-Za-z]:\// || entry == ".." ||
		entry ~ /^\.\.\// || entry ~ /\/\.\.\// || entry ~ /\/\.\.$/) {
		bad = 1
	}
}
END { exit bad }
'
}

archive_is_safe() {
	local asset_file="$1"
	local entries details kind

	kind="$(classify_archive "$asset_file")"
	case "$kind" in
		tar.gz|tar.xz)
			entries="$(tar_list_entries "$kind" "$asset_file")" || return 1
			printf '%s\n' "$entries" | archive_paths_are_safe || return 1
			details="$(tar_list_entries "$kind" "$asset_file" v)" || return 1
			printf '%s\n' "$details" | awk '
				{ type = substr($0, 1, 1); if (type != "-" && type != "d") bad = 1 }
				END { exit bad }
			' || return 1
		;;
		zip)
			if command -v unzip >/dev/null 2>&1; then
				entries="$(unzip -Z1 "$asset_file" 2>/dev/null)" || return 1
				printf '%s\n' "$entries" | archive_paths_are_safe || return 1
				details="$(unzip -Z -l "$asset_file" 2>/dev/null)" || return 1
				printf '%s\n' "$details" | awk '
					$1 ~ /^l/ { bad = 1 }
					END { exit bad }
				' || return 1
			elif command -v bsdtar >/dev/null 2>&1; then
				entries="$(bsdtar -tf "$asset_file" 2>/dev/null)" || return 1
				printf '%s\n' "$entries" | archive_paths_are_safe || return 1
				details="$(bsdtar -tvf "$asset_file" 2>/dev/null)" || return 1
				printf '%s\n' "$details" | awk '
					{ type = substr($0, 1, 1); if (type != "-" && type != "d") bad = 1 }
					END { exit bad }
				' || return 1
			else
				# BusyBox unzip cannot list entries without extracting them safely.
				return 1
			fi
		;;
		*)
			# Unknown container type; refuse to extract rather than trust a bare file.
			return 1
		;;
	esac

	return 0
}

validate_asset_file() {
	local asset_file="$1"
	local kind

	[ -s "$asset_file" ] || return 1

	kind="$(classify_archive "$asset_file")"
	case "$kind" in
		zip)
			if command -v unzip >/dev/null 2>&1; then
				unzip -t "$asset_file" >/dev/null 2>&1 && return 0
			fi
			if command -v busybox >/dev/null 2>&1; then
				busybox unzip -t "$asset_file" >/dev/null 2>&1 && return 0
			fi
			if command -v bsdtar >/dev/null 2>&1; then
				bsdtar -tf "$asset_file" >/dev/null 2>&1 && return 0
			fi
			return 1
		;;
		tar.gz|tar.xz)
			tar_list_entries "$kind" "$asset_file" >/dev/null 2>&1
			return $?
		;;
		*)
			return 0
		;;
	esac
}

validate_release_asset() {
	local asset_file="$1"

	validate_asset_file "$asset_file" || return 1
	return 0
}

extract_release_asset() {
	local asset_file="$1"
	local dest_dir="$2"
	local base kind

	archive_is_safe "$asset_file" || return 1

	rm -rf "$dest_dir"
	mkdir -p "$dest_dir"

	kind="$(classify_archive "$asset_file")"
	case "$kind" in
		tar.gz)
			tar_extract_entries tar.gz "$asset_file" "$dest_dir" || return 1
		;;
		tar.xz)
			tar_extract_entries tar.xz "$asset_file" "$dest_dir" || return 1
		;;
		zip)
			extract_zip_asset "$asset_file" "$dest_dir" || return 1
		;;
		elf|*)
			base="$(basename "$asset_file")"
			cp -f "$asset_file" "${dest_dir}/${base}" >/dev/null 2>&1 || return 1
		;;
	esac
}

locate_extracted_bin() {
	local root="$1"
	local name="$2"
	local alt_dash alt_under found

	alt_dash="$(printf '%s' "$name" | tr '_' '-')"
	alt_under="$(printf '%s' "$name" | tr '-' '_')"

	found="$(
		find "$root" -type f \
			\( \
				-name "$name" -o \
				-name "${name}.bin" -o \
				-name "$alt_dash" -o \
				-name "${alt_dash}.bin" -o \
				-name "$alt_under" -o \
				-name "${alt_under}.bin" -o \
				-name "${name}-*" -o \
				-name "${name}_*" -o \
				-name "${alt_dash}-*" -o \
				-name "${alt_dash}_*" -o \
				-name "${alt_under}-*" -o \
				-name "${alt_under}_*" \
			\) 2>/dev/null | head -n1
	)"
	[ -n "$found" ] && {
		echo "$found"
		return 0
	}

	return 1
}


install_binary_to_usrbin() {
	local src="$1"
	local target_name="$2"
	local target_path temp_path

	[ -n "$src" ] || return 1
	[ -f "$src" ] || return 1
	[ -n "$target_name" ] || return 1
	target_path="${INSTALL_BIN_DIR}/${target_name}"
	temp_path="${target_path}.$$"

	mkdir -p "${INSTALL_BIN_DIR}" >/dev/null 2>&1 || {
		log_download "failed to create install directory ${INSTALL_BIN_DIR}"
		return 1
	}
	rm -f "$temp_path" >/dev/null 2>&1
	cp -f "$src" "$temp_path" >/dev/null 2>&1 || {
		log_download "failed to copy binary to ${target_path} from ${src}"
		rm -f "$temp_path" >/dev/null 2>&1
		return 1
	}
	chmod 755 "$temp_path" >/dev/null 2>&1 || {
		log_download "failed to chmod binary ${target_path}"
		rm -f "$temp_path" >/dev/null 2>&1
		return 1
	}
	# Optional UPX compression to shrink the on-disk binary (helps small-flash
	# routers). UPX rewrites the file in place; the result stays a valid ELF.
	upx_compress="${VNT2_UPX_COMPRESS:-0}"
	if [ "$upx_compress" = "1" ] && upx_is_usable; then
		if upx -q -q --force "$temp_path" >/dev/null 2>&1; then
			log_download "UPX compressed ${target_name}"
		else
			log_download "UPX compression skipped/failed for ${target_name}, installing uncompressed"
		fi
	fi
	is_elf_binary "$temp_path" || {
		log_download "installed binary is not a valid ELF file ${target_path}"
		rm -f "$temp_path" >/dev/null 2>&1
		return 1
	}
	mv -f "$temp_path" "$target_path" >/dev/null 2>&1 || {
		log_download "failed to atomically replace installed binary ${target_path}"
		rm -f "$temp_path" >/dev/null 2>&1
		return 1
	}
	[ -f "$target_path" ] || {
		log_download "binary not found after install ${target_path}"
		return 1
	}
	echo "$target_path"
	return 0
}

install_bundle_to_usrbin() {
	local extracted_dir="$1"
	local cli_bin ctrl_bin
	local cli_installed ctrl_installed

	cli_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_cli")" || return 1
	ensure_elf_exec "$cli_bin" || return 1
	install_binary_to_usrbin "$cli_bin" "vnt2_cli" >/dev/null || return 1

	ctrl_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")" || return 1
	ensure_elf_exec "$ctrl_bin" || return 1
	install_binary_to_usrbin "$ctrl_bin" "vnt2_ctrl" >/dev/null || return 1

	# B. Post-install health check: actually run the binaries. is_elf_binary only
	# proves a valid ELF header; a binary built for the wrong endian/float ABI
	# still has a valid header yet fails at exec time. A failed health check
	# means the downloaded asset does not run on this device.
	cli_installed="${INSTALL_BIN_DIR}/vnt2_cli"
	ctrl_installed="${INSTALL_BIN_DIR}/vnt2_ctrl"
	if ! binary_health_check "$cli_installed"; then
		log_download "安装后健康检查失败: ${cli_installed} 无法在本机执行 (可能架构不匹配)"
		return 1
	fi
	if ! binary_health_check "$ctrl_installed"; then
		log_download "安装后健康检查警告: ${ctrl_installed} 无法在本机执行 (控制工具可能架构不匹配)"
	fi

	return 0
}

cache_bundle_ready() {
	local extracted_dir="$1"

	ensure_elf_exec "$(locate_extracted_bin "$extracted_dir" "vnt2_cli")" || return 1
	ensure_elf_exec "$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")"
}

auto_download_bundle_for_mode() {
	local cfg="$1"
	local scope="$2"
	local state_file="$3"

	local auto_download download_tag download_repo download_mirror custom_mirror_url cache_mirror_key candidate_mirror api_url arch_name
	local mirror_attempt mirror_retry_limit
	local cache_key cache_dir query_dir json_file release_tag asset_url asset_name asset_file extracted_dir
	local fallback_version fallback_url asset_size
	local checksum_url expected_sha installed_cli downloaded_sha extracted_sha local_sha
	local cli_bin ctrl_bin
	asset_name=""

	config_get_bool auto_download "$cfg" "auto_download" "1"
	[ "$auto_download" = "1" ] || {
		write_download_state "$state_file" "disabled" "auto download disabled" "" "" "" ""
		return 1
	}

	case "$scope" in
		cli)
			download_tag="$VNT2_FIXED_VERSION"
			download_repo="$VNT2_FIXED_REPO"
			config_get download_mirror "$cfg" "download_mirror" "auto"
			config_get custom_mirror_url "$cfg" "custom_download_mirror" ""
		;;
		*)
			return 1
		;;
	esac
	config_get_bool VNT2_UPX_COMPRESS "$cfg" "upx_compress" "0"
	ensure_runtime_deps "$VNT2_UPX_COMPRESS"
	download_mirror="$(normalize_download_mirror "$download_mirror")"
	custom_mirror_url="$(normalize_custom_mirror_url "$custom_mirror_url")"
	cache_mirror_key="$(get_download_mirror_cache_key "$download_repo" "$download_mirror" "$custom_mirror_url")"

	# I. Clear stale download cache before a fresh attempt so /tmp does not
	# accumulate old bundles across versions and mirror retries. Recent caches
	# (used by the reuse path) are kept; only >7-day-old dirs and partial files
	# are pruned.
	find "$DOWNLOAD_CACHE_BASE" -mindepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null
	rm -f "${DOWNLOAD_CACHE_BASE}"/*.part "${DOWNLOAD_CACHE_BASE}"/*.tmp 2>/dev/null

	arch_name="$(detect_arch_name)"
	case "$arch_name" in
		x86_64|aarch64|armv7-musleabihf|armv7-musleabi|arm-musleabihf|arm-musleabi|mips|mipsel)
			;;
		*)
			log_download "unsupported device architecture: ${arch_name:-unknown}"
			write_download_state "$state_file" "failed" "unsupported device architecture" "" "$download_tag" "${arch_name:-unknown}" ""
			return 1
		;;
	esac

	# Reconcile compression state BEFORE the skip gate: if the user toggled
	# compression, delete the on-disk binary so the download below re-fetches it
	# in the desired (compressed/uncompressed) form instead of skipping.
	reconcile_upx_state "$VNT2_UPX_COMPRESS"

	# Skip-download gate: the upstream asset is an UNCOMPRESSED original, while
	# the locally installed binary may be UPX-compressed. Their SHA256 can never
	# match, so comparing SHA256 to decide whether to skip is unreliable. Instead
	# we simply check whether the target programs already exist in the install
	# directory by name. If both are present and valid ELF files we treat the
	# program as already installed and skip downloading entirely.
	installed_cli="${INSTALL_BIN_DIR}/vnt2_cli"
	installed_ctrl="${INSTALL_BIN_DIR}/vnt2_ctrl"
	if [ -f "$installed_cli" ] && is_elf_binary "$installed_cli" && \
	   [ -f "$installed_ctrl" ] && is_elf_binary "$installed_ctrl"; then
		log_download "本地 /usr/bin 已存在 vnt2_cli 与 vnt2_ctrl，跳过下载"
		write_download_state "$state_file" "success" "本地已存在同名程序，跳过下载" "" "$download_tag" "$arch_name" "$installed_cli"
		write_version_state "$download_tag" "local-exists" "$arch_name" "" "$installed_cli" "$installed_ctrl" || \
			log_download "failed to persist version state tag=${download_tag}"
		uci -q set "${CONF}.${cfg}.vnt2_cli_bin=${INSTALL_BIN_DIR}/vnt2_cli"
		uci -q set "${CONF}.${cfg}.vnt2_ctrl_bin=${INSTALL_BIN_DIR}/vnt2_ctrl"
		uci commit "$CONF" >/dev/null 2>&1
		return 0
	fi

	# A. Disk space precheck (helps 4MB-flash devices such as AR9331). Compute
	# the expected asset size once from the canonical URL; sizes are identical
	# across mirrors. Require enough room in /tmp for archive+extraction, and in
	# /usr/bin for the installed binaries. If the size is unknown we skip the
	# check and let the download fail naturally rather than risk a false reject.
	precheck_asset_url="$(get_release_asset_url "$download_repo" "$scope" "$download_tag" "$arch_name" 2>/dev/null)"
	if [ -n "$precheck_asset_url" ]; then
		precheck_len="$(fetch_content_length "$precheck_asset_url" "$(get_downloader asset 2>/dev/null || echo curl)")"
		precheck_len_kb=$(( ${precheck_len:-0} / 1024 ))
		if [ "$precheck_len_kb" -gt 0 ]; then
			# The downloaded asset is the UNCOMPRESSED original; the binaries are
			# UPX-compressed on install, so they end up SMALLER than the asset.
			# Need: /tmp for archive + extraction (~2x), /usr/bin for the two
			# installed binaries (<= asset size, plus a small margin). No large
			# fixed floor, otherwise 4MB-flash devices would be rejected outright.
			need_dl_kb=$(( precheck_len_kb * 2 + 1024 ))
			need_install_kb=$(( precheck_len_kb + 2048 ))
			if ! check_free_space "${DOWNLOAD_CACHE_BASE}" "$need_dl_kb"; then
				log_download "下载目录空间不足(需约 $(format_size $((need_dl_kb * 1024))) 可用)，跳过下载"
				write_download_state "$state_file" "failed" "下载目录空间不足，无法下载" "" "$download_tag" "$arch_name" ""
				log_event "insufficient_space" "download_dir need=$(format_size $((need_dl_kb * 1024)))"
				return 1
			fi
			if ! check_free_space "${INSTALL_BIN_DIR}" "$need_install_kb"; then
				log_download "安装目录空间不足(需约 $(format_size $((need_install_kb * 1024))) 可用)，跳过下载"
				write_download_state "$state_file" "failed" "安装目录空间不足，无法安装" "" "$download_tag" "$arch_name" ""
				log_event "insufficient_space" "install_dir need=$(format_size $((need_install_kb * 1024)))"
				return 1
			fi
		else
			log_download "无法获取资源大小，跳过空间预检(交由下载过程自然反馈)"
		fi
	fi

	query_dir="${DOWNLOAD_CACHE_BASE}/query_$(sanitize_name "${cache_mirror_key}_${download_repo}_${download_tag}_${arch_name}_${scope}")"
	json_file="${query_dir}/release.json"
	mkdir -p "$query_dir"

	log_download "query fixed release repo=${download_repo} tag=${download_tag} arch=${arch_name} scope=${scope}"
	for candidate_mirror in $(get_download_mirror_candidates "$download_repo" "$download_mirror"); do
		mirror_retry_limit="$DOWNLOAD_MIRROR_RETRIES"
		[ "$candidate_mirror" = "custom" ] && mirror_retry_limit=1
		for mirror_attempt in $(seq 1 "$mirror_retry_limit"); do
			log_download "mirror attempt ${mirror_attempt}/${mirror_retry_limit} mirror=${candidate_mirror} scope=${scope}"
			write_download_state "$state_file" "querying" "querying releases (${candidate_mirror})" "" "$download_tag" "$arch_name" ""
			log_download "querying ${scope} release repo=${download_repo} tag=${download_tag} mirror=${candidate_mirror} strategy=${download_mirror} arch=${arch_name}"
			api_url="$(fetch_release_metadata_from_mirror "$download_repo" "$download_tag" "$json_file" "$candidate_mirror" "$custom_mirror_url")"
			if [ -z "$api_url" ]; then
				log_download "release query failed repo=${download_repo} tag=${download_tag} mirror=${candidate_mirror}"
				if [ "$candidate_mirror" != "github" ]; then
					continue
				fi
				fallback_version="$VNT2_FIXED_VERSION"
				fallback_url="$(get_release_asset_url "$download_repo" "$scope" "$fallback_version" "$arch_name" 2>/dev/null)"
				if [ -z "$fallback_url" ]; then
					continue
				fi
				cat >"$json_file" <<EOF
{"tag_name":"v${fallback_version}","assets":[{"browser_download_url":"${fallback_url}"}]}
EOF
				api_url="fallback:${fallback_url}"
				log_download "using built-in release fallback repo=${download_repo} tag=${fallback_version} asset_url=${fallback_url}"
			fi

			log_download "release query ok: ${api_url} used_url=${DOWNLOAD_LAST_URL:-unknown} mirror=${candidate_mirror}"
			release_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n1)"
			release_tag="$(normalize_release_tag "$release_tag")"
			[ "$release_tag" = "$VNT2_FIXED_VERSION" ] || {
				log_download "release metadata tag mismatch expected=${VNT2_FIXED_VERSION} mirror=${candidate_mirror}"
				continue
			}
			cache_key="$(sanitize_name "${cache_mirror_key}_${candidate_mirror}_${download_repo}_${release_tag}_${arch_name}_${scope}")"
			cache_dir="${DOWNLOAD_CACHE_BASE}/${cache_key}"
			extracted_dir="${cache_dir}/extracted"
			mkdir -p "$cache_dir"
			cp -f "$json_file" "${cache_dir}/release.json" >/dev/null 2>&1

			asset_url="$(select_release_asset "$json_file" "$scope" "$release_tag" "$arch_name")" || {
				log_download "no release asset matched arch=${arch_name} scope=${scope} mirror=${candidate_mirror}"
				log_event "no_matching_asset" "arch=${arch_name} scope=${scope} mirror=${candidate_mirror}"
				continue
			}

			asset_name="$(basename "$asset_url")"
			asset_file="${cache_dir}/${asset_name}"
			write_download_state "$state_file" "downloading" "downloading release asset (${candidate_mirror})" "$asset_name" "$release_tag" "$arch_name" ""
			log_download "selected asset ${asset_name} mirror=${candidate_mirror} url=${asset_url}"

		# Compute the upstream checksum (if published) and keep it for the
		# POST-DOWNLOAD integrity check below. The pre-download "skip when local
		# SHA256 matches upstream" optimization was intentionally removed: the
		# locally installed binary is normally UPX-compressed while the upstream
		# asset is uncompressed, so their SHA256 can never match. The decision to
		# skip downloading is now made earlier and is based purely on whether the
		# binaries already exist by name in /usr/bin.
		checksum_url="$(release_checksum_asset_url "$json_file" "$asset_name")"
		expected_sha=""
		[ -n "$checksum_url" ] && expected_sha="$(fetch_release_sha256 "$checksum_url" "$asset_name")"
		[ -n "$expected_sha" ] && log_download "上游发布校验和 ${expected_sha}，将在下载后验证完整性"

			if cache_bundle_ready "$extracted_dir"; then
				log_download "cached bundle found, reuse ${extracted_dir} mirror=${candidate_mirror}"
				write_download_state "$state_file" "cached" "reusing local cached bundle" "$(basename "$cache_dir")" "$release_tag" "$arch_name" "$extracted_dir"
				if install_bundle_to_usrbin "$extracted_dir"; then
					write_version_state "$release_tag" "download-cache" "$arch_name" "$asset_name" "${INSTALL_BIN_DIR}/vnt2_cli" "${INSTALL_BIN_DIR}/vnt2_ctrl" || \
						log_download "failed to persist version state for cached bundle tag=${release_tag}"
					uci -q set "${CONF}.${cfg}.vnt2_cli_bin=${INSTALL_BIN_DIR}/vnt2_cli"
					uci -q set "${CONF}.${cfg}.vnt2_ctrl_bin=${INSTALL_BIN_DIR}/vnt2_ctrl"
					uci commit "$CONF" >/dev/null 2>&1
					return 0
				fi
			fi

			if [ -s "$asset_file" ]; then
				if validate_release_asset "$asset_file"; then
					log_download "reusing downloaded asset ${asset_file}"
				else
					log_download "cached asset invalid, remove and redownload ${asset_file}"
					rm -f "$asset_file"
				fi
			fi

			if [ ! -s "$asset_file" ]; then
				log_download "asset download started tool=$(get_downloader asset 2>/dev/null || echo unknown) timeout=180s mirror=${candidate_mirror} file=${asset_name}"
				if ! download_file "$asset_url" "$asset_file" "asset" "$candidate_mirror" "$custom_mirror_url"; then
					log_download "asset download failed tool=${DOWNLOAD_LAST_TOOL:-unknown} rc=${DOWNLOAD_LAST_RC:-unknown} received=${DOWNLOAD_LAST_BYTES:-0}B mirror=${candidate_mirror} used_url=${DOWNLOAD_LAST_URL:-unknown}"
					rm -f "$asset_file"
					break
				fi
				if ! validate_release_asset "$asset_file"; then
					asset_size="$(file_size "$asset_file" 2>/dev/null || echo 0)"
					log_download "downloaded release asset invalid or corrupted scope=${scope} file=${asset_file} size=${asset_size}B mirror=${candidate_mirror}"
					rm -f "$asset_file"
					break
				fi
				log_download "asset download ok tool=${DOWNLOAD_LAST_TOOL:-unknown} used_url=${DOWNLOAD_LAST_URL:-unknown} mirror=${candidate_mirror} file=${asset_file}"
				log_event "download_complete" "mirror=${candidate_mirror} size=$(format_size $(file_size "$asset_file" 2>/dev/null || echo 0))"
			fi

			if [ -n "$expected_sha" ]; then
				downloaded_sha="$(sha256_of "$asset_file")"
				if [ -n "$downloaded_sha" ] && [ "$downloaded_sha" != "$expected_sha" ]; then
					log_download "下载文件 SHA256 校验失败 (期望 ${expected_sha}, 实际 ${downloaded_sha})，丢弃并重试其他镜像"
					rm -f "$asset_file"
					break
				fi
				[ -n "$downloaded_sha" ] && log_download "下载文件 SHA256 校验通过 (${downloaded_sha})"
			fi

			write_download_state "$state_file" "extracting" "extracting program files (${candidate_mirror})" "$asset_name" "$release_tag" "$arch_name" ""
			if ! extract_release_asset "$asset_file" "$extracted_dir"; then
				log_download "extract failed, remove cache and switch mirror ${candidate_mirror} ${asset_file}"
				rm -rf "$extracted_dir"
				rm -f "$asset_file"
				break
			fi

			cli_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_cli")"
			if [ -z "$cli_bin" ] || [ ! -f "$cli_bin" ]; then
				log_download "bundle missing vnt2_cli mirror=${candidate_mirror}"
				rm -rf "$extracted_dir"
				continue
			fi
			ctrl_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")"
			if [ -z "$ctrl_bin" ] || [ ! -f "$ctrl_bin" ]; then
				log_download "bundle missing vnt2_ctrl mirror=${candidate_mirror}"
				rm -rf "$extracted_dir"
				continue
			fi
			if ! ensure_elf_exec "$cli_bin" || ! ensure_elf_exec "$ctrl_bin"; then
				log_download "bundle binaries are not valid ELF files mirror=${candidate_mirror}"
				rm -rf "$extracted_dir"
				continue
			fi
			# If the extracted binary is byte-identical (SHA256) to the already
			# installed one, there is no need to overwrite it.
			installed_cli="${INSTALL_BIN_DIR}/vnt2_cli"
			if [ -f "$installed_cli" ] && is_elf_binary "$installed_cli" && [ -f "$cli_bin" ]; then
				extracted_sha="$(sha256_of "$cli_bin")"
				local_sha="$(sha256_of "$installed_cli")"
				if [ -n "$extracted_sha" ] && [ "$extracted_sha" = "$local_sha" ]; then
					log_download "解压出的 vnt2_cli 与已安装程序 SHA256 一致，跳过覆盖安装"
					write_download_state "$state_file" "success" "已安装程序与下载内容一致，无需覆盖" "$asset_name" "$release_tag" "$arch_name" "$installed_cli"
					write_version_state "$release_tag" "download-skip" "$arch_name" "$asset_name" "$installed_cli" "${INSTALL_BIN_DIR}/vnt2_ctrl" || \
						log_download "failed to persist version state tag=${release_tag}"
					uci -q set "${CONF}.${cfg}.vnt2_cli_bin=${INSTALL_BIN_DIR}/vnt2_cli"
					uci -q set "${CONF}.${cfg}.vnt2_ctrl_bin=${INSTALL_BIN_DIR}/vnt2_ctrl"
					uci commit "$CONF" >/dev/null 2>&1
					return 0
				fi
			fi
			if ! install_bundle_to_usrbin "$extracted_dir"; then
				log_download "install bundle to /usr/bin failed"
				write_download_state "$state_file" "failed" "install bundle to /usr/bin failed" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			uci -q set "${CONF}.${cfg}.vnt2_cli_bin=${INSTALL_BIN_DIR}/vnt2_cli"
			uci -q set "${CONF}.${cfg}.vnt2_ctrl_bin=${INSTALL_BIN_DIR}/vnt2_ctrl"
			uci commit "$CONF" >/dev/null 2>&1
			log_download "bundle installed: cli=${INSTALL_BIN_DIR}/vnt2_cli ctrl=${INSTALL_BIN_DIR}/vnt2_ctrl mirror=${candidate_mirror} url=${asset_url}"
			log_event "install_success" "cli=${INSTALL_BIN_DIR}/vnt2_cli ctrl=${INSTALL_BIN_DIR}/vnt2_ctrl mirror=${candidate_mirror}"
			write_download_state "$state_file" "success" "installed vnt2_cli and vnt2_ctrl to /usr/bin" "$asset_name" "$release_tag" "$arch_name" "${INSTALL_BIN_DIR}/vnt2_cli"
			write_version_state "$release_tag" "download" "$arch_name" "$asset_name" "${INSTALL_BIN_DIR}/vnt2_cli" "${INSTALL_BIN_DIR}/vnt2_ctrl" || \
				log_download "failed to persist version state tag=${release_tag}"
			return 0
		done
	done

	write_download_state "$state_file" "failed" "all download mirrors failed" "${asset_name:-unknown}" "$download_tag" "$arch_name" ""
	log_download "all download mirrors failed repo=${download_repo} tag=${download_tag} strategy=${download_mirror} arch=${arch_name} scope=${scope}"
	log_event "all_mirrors_failed" "repo=${download_repo} tag=${download_tag} arch=${arch_name}"
	return 1
}

auto_download_bundle() {
	local cfg="$1"
	local scope="$2"
	local state_file="$3"
	local auto_download

	config_get_bool auto_download "$cfg" "auto_download" "1"
	[ "$auto_download" = "1" ] || {
		write_download_state "$state_file" "disabled" "auto download disabled" "" "" "" ""
		return 1
	}

	auto_download_bundle_for_mode "$cfg" "$scope" "$state_file"
}

prepare_binary() {
	local cfg="$1"
	local option="$2"
	local default_path="$3"
	local upload_name="$4"
	local state_file="$5"
	local scope="$6"

	local bin managed_binary_needs_update=0 auto_download
	config_get bin "$cfg" "$option" "$default_path"

	case "$scope" in
		cli)
			if ensure_elf_exec "$bin"; then
				if fixed_binary_state_matches "$bin"; then
					echo "$bin"
					return 0
				fi
				config_get_bool auto_download "$cfg" "auto_download" "1"
				if [ "$auto_download" = "1" ]; then
					managed_binary_needs_update=1
					log_download "installed ${scope} binary is not the fixed version ${VNT2_FIXED_VERSION}, attempting replacement"
				else
					echo "$bin"
					return 0
				fi
			fi
		;;
		*)
			return 1
		;;
	esac

	if auto_download_bundle "$cfg" "$scope" "$state_file"; then
		bin="$(uci -q get "${CONF}.${cfg}.${option}")"
		if ensure_elf_exec "$bin"; then
			echo "$bin"
			return 0
		fi
	fi

	# Manual uploads are staged by LuCI and installed asynchronously by
	# /usr/libexec/vnt2/upload-worker, which also points vnt2_cli_bin at
	# /usr/bin/vnt2_cli. When automatic download fails, fall back to that
	# already installed upload instead of reading stale files from /tmp.
	config_get bin "$cfg" "$option" "$default_path"
	if ensure_elf_exec "$bin"; then
		if [ "$managed_binary_needs_update" = "1" ]; then
			log_download "${scope} fixed-version download failed, fallback to installed binary ${bin}"
		else
			log_download "${scope} auto download failed, fallback to installed binary ${bin}"
		fi
		write_download_state "$state_file" "fallback" "fixed-version download failed, using installed binary" "$(basename "$bin")" "" "$(detect_arch_name)" "$bin"
		echo "$bin"
		return 0
	fi

	return 1
}

uci_set_if_changed() {
	local key="$1"
	local value="$2"
	local current

	current="$(uci -q get "$key" 2>/dev/null)" || current=""
	[ "$current" = "$value" ] && return 0
	uci set "${key}=${value}"
}

uci_delete_if_exists() {
	local key="$1"

	uci -q get "$key" >/dev/null 2>&1 || return 0
	uci -q delete "$key"
}

apply_network_config_changes() {
	local action="${1:-reload}"
	local changed=0
	local run_ifup=0

	[ -n "$(uci changes network)" ] && changed=1
	if [ "$changed" -eq 1 ]; then
		uci commit network || return 1
	fi

	case "$action" in
		ifup)
			run_ifup="$changed"
			if [ "$run_ifup" -eq 0 ] && command -v ifstatus >/dev/null 2>&1; then
				ifstatus VNT2 2>/dev/null | grep -q '"up":[[:space:]]*true' || run_ifup=1
			fi
			[ "$run_ifup" -eq 1 ] || return 0
			if command -v ifup >/dev/null 2>&1; then
				ifup VNT2 >/dev/null 2>&1 || return 1
			elif [ -x /sbin/ifup ]; then
				/sbin/ifup VNT2 >/dev/null 2>&1 || return 1
			else
				return 1
			fi
		;;
		reload)
			if [ "$changed" -eq 1 ] && [ -x /etc/init.d/network ]; then
				/etc/init.d/network reload >/dev/null 2>&1 || return 1
			fi
		;;
		none) : ;;
		*) return 1 ;;
	esac
	return 0
}

apply_firewall_config_changes() {
	[ -n "$(uci changes firewall)" ] || return 0
	uci commit firewall || return 1
	[ -x /etc/init.d/firewall ] || return 0
	/etc/init.d/firewall reload >/dev/null 2>&1 || return 1
}

configure_network() {
	local tun_name="$1"
	local forward_list="$2"
	local no_nat="$3"
	local lan_zone wan_zone

	[ -n "$tun_name" ] || return 1
	lan_zone="$(find_firewall_zone_name "lan" 2>/dev/null || true)"
	wan_zone="$(find_firewall_zone_name "wan" 2>/dev/null || true)"

	uci_set_if_changed network.VNT2 'interface' || return 1
	uci_set_if_changed network.VNT2.proto 'none' || return 1
	uci_set_if_changed network.VNT2.device "$tun_name" || return 1
	uci_set_if_changed network.VNT2.ifname "$tun_name" || return 1

	uci_set_if_changed firewall.vnt2zone 'zone' || return 1
	uci_set_if_changed firewall.vnt2zone.name 'VNT2' || return 1
	uci_set_if_changed firewall.vnt2zone.input 'ACCEPT' || return 1
	uci_set_if_changed firewall.vnt2zone.output 'ACCEPT' || return 1
	uci_set_if_changed firewall.vnt2zone.forward 'ACCEPT' || return 1
	if [ "${no_nat:-0}" = "1" ]; then
		uci_set_if_changed firewall.vnt2zone.masq '0' || return 1
	else
		uci_set_if_changed firewall.vnt2zone.masq '1' || return 1
	fi
	uci_set_if_changed firewall.vnt2zone.mtu_fix '1' || return 1
	uci_set_if_changed firewall.vnt2zone.network 'VNT2' || return 1

	case " $forward_list " in
		*" vnt2fwlan "*)
			if [ -n "$lan_zone" ]; then
				uci_set_if_changed firewall.vnt2fwlan 'forwarding' || return 1
				uci_set_if_changed firewall.vnt2fwlan.src 'VNT2' || return 1
				uci_set_if_changed firewall.vnt2fwlan.dest "${lan_zone}" || return 1
			else
				uci_delete_if_exists firewall.vnt2fwlan || return 1
			fi
		;;
		*)
			uci_delete_if_exists firewall.vnt2fwlan || return 1
		;;
	esac

	case " $forward_list " in
		*" vnt2fwwan "*)
			if [ -n "$wan_zone" ]; then
				uci_set_if_changed firewall.vnt2fwwan 'forwarding' || return 1
				uci_set_if_changed firewall.vnt2fwwan.src 'VNT2' || return 1
				uci_set_if_changed firewall.vnt2fwwan.dest "${wan_zone}" || return 1
			else
				uci_delete_if_exists firewall.vnt2fwwan || return 1
			fi
		;;
		*)
			uci_delete_if_exists firewall.vnt2fwwan || return 1
		;;
	esac

	case " $forward_list " in
		*" lanfwvnt2 "*)
			if [ -n "$lan_zone" ]; then
				uci_set_if_changed firewall.lanfwvnt2 'forwarding' || return 1
				uci_set_if_changed firewall.lanfwvnt2.src "${lan_zone}" || return 1
				uci_set_if_changed firewall.lanfwvnt2.dest 'VNT2' || return 1
			else
				uci_delete_if_exists firewall.lanfwvnt2 || return 1
			fi
		;;
		*)
			uci_delete_if_exists firewall.lanfwvnt2 || return 1
		;;
	esac

	case " $forward_list " in
		*" wanfwvnt2 "*)
			if [ -n "$wan_zone" ]; then
				uci_set_if_changed firewall.wanfwvnt2 'forwarding' || return 1
				uci_set_if_changed firewall.wanfwvnt2.src "${wan_zone}" || return 1
				uci_set_if_changed firewall.wanfwvnt2.dest 'VNT2' || return 1
			else
				uci_delete_if_exists firewall.wanfwvnt2 || return 1
			fi
		;;
		*)
			uci_delete_if_exists firewall.wanfwvnt2 || return 1
		;;
	esac

	apply_network_config_changes none || return 1
	apply_firewall_config_changes || return 1
	# no_nat=1 disables VNT's built-in NAT and asks the operating system to
	# perform forwarding instead, so IPv4 forwarding must then be enabled.
	if [ "${no_nat:-0}" = "1" ]; then
		sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
	fi
	if ! apply_network_config_changes ifup; then
		# The device does not have to exist yet: the interface is configured
		# ahead of the client so the router shows it right away, and netifd
		# brings it up when the card appears. A failed ifup is a pending
		# state, not a failure, and must not trigger a retry storm.
		log_service "network sync pending: VNT2 waits for device ${tun_name}"
	fi
	return 0
}

cleanup_network() {
	if uci -q get network.VNT2 >/dev/null 2>&1; then
		if command -v ifdown >/dev/null 2>&1; then
			ifdown VNT2 >/dev/null 2>&1 || true
		elif [ -x /sbin/ifdown ]; then
			/sbin/ifdown VNT2 >/dev/null 2>&1 || true
		fi
	fi
	rm -f "${LAST_DEVICE_STATE_FILE}" 2>/dev/null || true
	uci_delete_if_exists network.VNT2 || return 1
	uci_delete_if_exists firewall.vnt2zone || return 1
	uci_delete_if_exists firewall.vnt2fwlan || return 1
	uci_delete_if_exists firewall.vnt2fwwan || return 1
	uci_delete_if_exists firewall.lanfwvnt2 || return 1
	uci_delete_if_exists firewall.wanfwvnt2 || return 1
	apply_network_config_changes none || return 1
	apply_firewall_config_changes || return 1
	return 0
}

device_mode_matches_tun_flags() {
	local mode="$1"
	local flags="$2"

	flags="$(trim_value "$flags")"
	case "$flags" in
		0x*|0X*)
			case "${flags#??}" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
		;;
		''|*[!0-9]*) return 1 ;;
	esac
	[ -n "$flags" ] || return 1

	case "$mode" in
		tun) [ $((flags & 3)) -eq 1 ] ;;
		tap) [ $((flags & 3)) -eq 2 ] ;;
		*) return 1 ;;
	esac
}

device_mode_matches_link_details() {
	local mode="$1"
	local details="$2"

	[ -n "$details" ] || return 1
	case "$mode" in
		tun)
		case "$details" in
			*"tun type tun"*|*"type tun"*|*"mode tun"*) return 0 ;;
			*) return 1 ;;
		esac
		;;
		tap)
		case "$details" in
			*"tun type tap"*|*"type tap"*|*"mode tap"*) return 0 ;;
			*) return 1 ;;
		esac
		;;
		*) return 1 ;;
	esac
}

read_tun_device_type() {
	local device="$1"
	local flags details

	[ -n "$device" ] || return 1
	[ -d "${SYS_CLASS_NET}/${device}" ] || return 1

	# tun_flags is the authoritative kernel marker when available. Some
	# OpenWrt kernels or iproute2 builds do not expose it, so retain a
	# conservative iproute2 fallback instead of treating a running device as
	# absent.
	if [ -f "${SYS_CLASS_NET}/${device}/tun_flags" ]; then
		flags="$(cat "${SYS_CLASS_NET}/${device}/tun_flags" 2>/dev/null || true)"
		case "$flags" in
			0x*|0X*|*[!0-9]*) : ;;
			*)
				case $((flags & 3)) in
					1) printf '%s\n' tun; return 0 ;;
					2) printf '%s\n' tap; return 0 ;;
				esac
			;;
		esac
		if device_mode_matches_tun_flags tun "$flags"; then
			printf '%s\n' tun
			return 0
		fi
		if device_mode_matches_tun_flags tap "$flags"; then
			printf '%s\n' tap
			return 0
		fi
	fi

	if command -v ip >/dev/null 2>&1; then
		details="$(ip -d link show dev "$device" 2>/dev/null || true)"
		device_mode_matches_link_details tun "$details" && {
			printf '%s\n' tun
			return 0
		}
		device_mode_matches_link_details tap "$details" && {
			printf '%s\n' tap
			return 0
		}
	fi

	return 1
}

device_matches_mode() {
	local mode="$1"
	local device="$2"
	local detected

	detected="$(read_tun_device_type "$device" 2>/dev/null || true)"
	[ "$detected" = "$mode" ]
}

device_has_ipv4_address() {
	local device="$1"
	local address="$2"
	local output=""

	[ -n "$device" ] && [ -n "$address" ] || return 1
	if command -v ip >/dev/null 2>&1; then
		output="$(ip -4 -o addr show dev "$device" 2>/dev/null || true)"
		case "$output" in
			*" inet ${address}/"*) return 0 ;;
		esac
	fi
	if command -v ifconfig >/dev/null 2>&1; then
		output="$(ifconfig "$device" 2>/dev/null || true)"
		case "$output" in
			*"inet addr:${address} "*|*" inet ${address} "*) return 0 ;;
		esac
	fi
	return 1
}

device_has_any_ipv4_address() {
	local device="$1"
	local output=""

	[ -n "$device" ] || return 1
	if command -v ip >/dev/null 2>&1; then
		output="$(ip -4 -o addr show dev "$device" 2>/dev/null || true)"
		[ -n "$output" ] && return 0
		return 1
	fi
	if command -v ifconfig >/dev/null 2>&1; then
		output="$(ifconfig "$device" 2>/dev/null || true)"
		case "$output" in
			*"inet addr:"*|*" inet "*) return 0 ;;
		esac
		return 1
	fi
	# Keep compatibility with minimal systems where address inspection is not
	# available; device type checks still prevent placeholder bindings.
	return 0
}

detect_configured_tun_device() {
	local mode="$1"
	local address="$2"
	local preferred_device="${3:-}"
	local dir name detected prefix
	local match_count=0 first_match="" preferred_match=""
	local prefix_match="" prefix_match_count=0
	local address_match="" address_match_count=0

	[ -d "$SYS_CLASS_NET" ] || return 1

	for dir in "$SYS_CLASS_NET"/*; do
		[ -d "$dir" ] || continue
		name="${dir##*/}"
		[ -n "$name" ] || continue
		detected="$(read_tun_device_type "$name" 2>/dev/null || true)"
		[ "$detected" = "$mode" ] || continue
		match_count=$((match_count + 1))
		[ -n "$first_match" ] || first_match="$name"
		if [ -z "$preferred_match" ] && [ "$name" = "$preferred_device" ]; then
			preferred_match="$name"
		fi
		if [ -n "$address" ] && device_has_ipv4_address "$name" "$address"; then
			address_match_count=$((address_match_count + 1))
			address_match="$name"
		fi
		case "$mode" in
			tap) prefix="tap" ;;
			tun) prefix="tun" ;;
			*) prefix="" ;;
		esac
		if [ -n "$prefix" ]; then
			case "$name" in
				"${prefix}"*)
					prefix_match_count=$((prefix_match_count + 1))
					[ -n "$prefix_match" ] || prefix_match="$name"
				;;
			esac
		fi
	done

	# A configured address identifies the instance; never bind another VPN
	# while the requested device is still being created or assigned its IP.
	if [ -n "$address" ]; then
		[ "$address_match_count" -eq 1 ] || return 1
		printf '%s\n' "$address_match"
		return 0
	fi
	if [ "$match_count" -eq 1 ]; then
		printf '%s\n' "$first_match"
		return 0
	fi
	if [ -n "$preferred_match" ]; then
		printf '%s\n' "$preferred_match"
		return 0
	fi
	if [ "$prefix_match_count" -eq 1 ]; then
		printf '%s\n' "$prefix_match"
		return 0
	fi
	return 1
}

sync_network_state() {
	local cfg="" forward_list="" mode tun_name no_nat
	local enabled=0
	local existing_device=""
	local configured_ip=""
	local detected=""
	local pending=0

	NETWORK_SYNC_RESULT=""
	config_load "$CONF"
	cfg="$(get_first_section_id "vnt2_cli")"
	if [ -n "$cfg" ]; then
		config_get_bool enabled "$cfg" "enabled" "0"
	fi

	# The managed interface and firewall zone belong to the configured client,
	# not to a device that happens to be up: they are created as soon as the
	# client is enabled and only removed when it is disabled or runs without a
	# virtual card. Waiting for the runtime device used to delay both by
	# minutes - the card only appears once the tunnel is established - and
	# dropped them again on every reconnect.
	if [ "$enabled" != "1" ]; then
		cleanup_network || return 1
		NETWORK_SYNC_RESULT="client-disabled"
		return 0
	fi

	prepare_client_network_runtime "$cfg"
	mode="$VNT2_DEVICE_MODE"
	tun_name="$VNT2_TUN_NAME"
	no_nat="$VNT2_NO_NAT"
	forward_list="$VNT2_FORWARD_LIST"

	case "$mode" in
		tun|tap) : ;;
		*)
			cleanup_network || return 1
			NETWORK_SYNC_RESULT="no-device-mode"
			return 0
		;;
	esac

	configured_ip="$(trim_value "$(config_get "$cfg" "ip")")"
	case "$configured_ip" in
		*/*) configured_ip="${configured_ip%%/*}" ;;
	esac
	case "$configured_ip" in
		[0-9]*.[0-9]*.[0-9]*.[0-9]*) : ;;
		*) configured_ip="" ;;
	esac

	case "$tun_name" in
		*/*|*..*) tun_name="" ;;
	esac

	# A running device is the only binding known to be correct, so it wins.
	detected="$(detect_configured_tun_device "$mode" "$configured_ip" "$tun_name" 2>/dev/null || true)"
	if [ -n "$detected" ]; then
		tun_name="$detected"
	else
		# The card is not up yet: bind the configured name (netifd waits for
		# it), then whatever the interface already uses, then the kernel
		# default name. The worker rebinds as soon as the real card shows up.
		pending=1
		if [ -z "$tun_name" ]; then
			existing_device="$(trim_value "$(uci -q get network.VNT2.device 2>/dev/null || true)")"
			# After a device_mode switch the old network.VNT2.device may still
			# hold the previous interface name (e.g. tun0 after tun→tap). Only
			# reuse it when its prefix matches the current mode, otherwise the
			# pending device name follows the new mode so netifd binds the
			# correct interface once the restarted client creates it.
			case "$existing_device" in
				"${mode}"*) tun_name="$existing_device" ;;
				*) tun_name="${mode}0" ;;
			esac
		fi
	fi

	if ! configure_network "$tun_name" "$forward_list" "$no_nat"; then
		NETWORK_SYNC_RESULT="configure-failed:${tun_name}"
		return 1
	fi
	if [ "$pending" -eq 1 ]; then
		NETWORK_SYNC_RESULT="pending-device:${tun_name}"
	else
		NETWORK_SYNC_RESULT="configured:${tun_name}"
	fi
	return 0
}

sync_network_command() {
	local rc

	sync_network_state
	rc=$?
	if [ "$rc" -eq 0 ]; then
		if [ -n "$NETWORK_SYNC_RESULT" ]; then
			# The worker polls every second; record the result only when it
			# changes so the running log is not flooded by steady state.
			local last
			last="$(cat /tmp/vnt2-sync.last 2>/dev/null)"
			if [ "$last" != "$NETWORK_SYNC_RESULT" ]; then
				log_service "network sync result: ${NETWORK_SYNC_RESULT}"
				printf '%s\n' "$NETWORK_SYNC_RESULT" > /tmp/vnt2-sync.last
			fi
		fi
		return 0
	fi
	log_service "network sync failed rc=${rc}"
	return "$rc"
}

sync_network() {
	sync_network_command
}

prepare_client_network_runtime() {
	local cfg="$1"
	local bind_dev="" forward_list="" forward_raw="" tun_name device_mode no_nat

	VNT2_FORWARD_LIST=""
	if [ -n "$cfg" ]; then
		config_get bind_dev "$cfg" "bind_dev"
		config_list_foreach "$cfg" vnt2_forward append_forward_item
		if [ -z "$VNT2_FORWARD_LIST" ]; then
			config_get forward_raw "$cfg" "vnt2_forward"
			append_forward_items_from_string "$forward_raw"
		fi
		forward_list="${VNT2_FORWARD_LIST}"
	fi

	# Network sync reads the UCI values directly; the runtime TOML is only
	# an exported copy for the client process.
	tun_name="$(trim_value "$(config_get "$cfg" "tun_name")")"
	device_mode="$(trim_value "$(config_get "$cfg" "device_mode")")"
	[ -n "$device_mode" ] || device_mode="tun"
	case "$device_mode" in
		no|tun|tap) : ;;
		*)
			log_service "invalid device_mode=${device_mode}, using tun"
			device_mode="tun"
		;;
	esac
	no_nat="$(config_get "$cfg" "no_nat")"
	case "$no_nat" in
		1) : ;;
		*) no_nat="0" ;;
	esac

	VNT2_BIND_DEV="${bind_dev}"
	VNT2_TUN_NAME="${tun_name}"
	VNT2_DEVICE_MODE="${device_mode}"
	VNT2_NO_NAT="${no_nat}"
	VNT2_FORWARD_LIST="${forward_list}"
	return 0
}

append_forward_item() {
	local value="$1"
	value="$(trim_value "$value")"
	[ -n "$value" ] || return 0
	if [ -n "${VNT2_FORWARD_LIST}" ]; then
		VNT2_FORWARD_LIST="${VNT2_FORWARD_LIST} ${value}"
	else
		VNT2_FORWARD_LIST="${value}"
	fi
}

append_forward_items_from_string() {
	local values="$1"
	local item

	values="$(trim_value "$values")"
	[ -n "$values" ] || return 0

	for item in $values; do
		append_forward_item "$item"
	done
}

valid_machine_id() {
	# The fixed upstream binary resolves its device identity through machine_uid,
	# which accepts any non-empty, printable machine-id: a 32-hex id, a UUID, or
	# another distribution-specific form. We accept the same shape and only reject
	# content that cannot serve as a device identity: empty/whitespace, control
	# characters, or the all-zero "uninitialized" sentinel that some systems write
	# before entropy is available. This also lets us reuse an OpenWrt-provided
	# /etc/machine-id instead of refusing to start because it is not 32 hex.
	[ -n "$1" ] || return 1
	case "$1" in
		*[[:space:]]*) return 1 ;;
	esac
	[ "$1" != "00000000000000000000000000000000" ] || return 1
	[ "${#1}" -ge 8 ] && [ "${#1}" -le 64 ]
}

# OpenWrt/iStoreOS images vary in which utilities they ship. Try several
# ways to produce 32 hex characters so a missing od/hextool never blocks
# the client from starting.
generate_machine_id() {
	local id

	id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]')"
	valid_machine_id "$id" && { echo "$id"; return 0; }

	id="$(hexdump -n16 -e '/1 "%02x"' /dev/urandom 2>/dev/null)"
	valid_machine_id "$id" && { echo "$id"; return 0; }

	id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | hexdump -ve '1/1 "%02x"')"
	valid_machine_id "$id" && { echo "$id"; return 0; }

	if command -v openssl >/dev/null 2>&1; then
		id="$(openssl rand -hex 16 2>/dev/null)"
		valid_machine_id "$id" && { echo "$id"; return 0; }
	fi

	return 1
}

read_machine_id() {
	local file="$1" id

	# Only regular files (following symlinks) are read, so a link to a device or a
	# directory is rejected rather than blocking startup on garbage. We avoid
	# stat/dd: busybox stat and dd behave inconsistently across OpenWrt images
	# (some ship a stat that returns nothing for our files), which previously made
	# a perfectly valid stored id fail to parse and triggered a spurious
	# "invalid stored machine-id" refusal on the second boot.
	[ -f "$file" ] || return 1
	id="$(cat "$file" 2>/dev/null)" || return 1
	id="$(trim_value "$id")"
	[ -n "$id" ] || return 1
	# Safety bound: device ids are short. Reject anything unexpectedly large so a
	# stray file cannot flood the id.
	[ "${#id}" -le 128 ] || return 1
	valid_machine_id "$id" || return 1
	printf '%s\n' "$id"
}

ensure_persistent_machine_id() {
	local id tmp dbus_id store_dir uci_id

	if [ -e "$DBUS_MACHINE_ID_FILE" ] && [ ! -f "$DBUS_MACHINE_ID_FILE" ]; then
		log_service 'D-Bus machine-id must be a regular file; client startup cancelled'
		return 1
	fi

	# 1) Authoritative record: UCI config. It persists across reboots and
	#    sysupgrades on OpenWrt regardless of whether /etc itself is a tmpfs, so the
	#    device identity is stable (9.4.1). A corrupt, non-empty record of our own
	#    triggers a refusal (9.4.5); an empty/missing one means first run. The
	#    offending value is logged so a misbehaving device can be diagnosed
	#    remotely without shell access to the exact file.
	uci_id="$(trim_value "$(uci -q get "${MACHINE_ID_UCI_PKG}.${MACHINE_ID_UCI_SEC}.value" 2>/dev/null)")"
	if [ -n "$uci_id" ] && ! valid_machine_id "$uci_id"; then
		log_service "invalid stored machine-id (uci ${MACHINE_ID_UCI_PKG}.${MACHINE_ID_UCI_SEC}.value='${uci_id}'); refusing to change device identity"
		return 1
	fi
	if valid_machine_id "$uci_id"; then
		id="$uci_id"
	else
		id=""
	fi

	# 2) No UCI record yet: adopt an existing usable /etc/machine-id so we reuse
	#    the system identity instead of inventing a new one (9.4.3). OpenWrt 25.x
	#    may have already written one; we accept its form (UUID, 32-hex, ...).
	if ! valid_machine_id "$id"; then
		if [ -e "$MACHINE_ID_FILE" ]; then
			id="$(read_machine_id "$MACHINE_ID_FILE")" || id=""
			if [ -z "$id" ] && [ -f "$MACHINE_ID_FILE" ]; then
				log_service 'warning: existing /etc/machine-id present but unreadable; ignoring it'
			fi
		fi
	fi

	# 3) Fall back to our own file store (e.g. after a UCI wipe), then the D-Bus
	#    id, then generate a fresh 32-hex id.
	if ! valid_machine_id "$id"; then
		id="$(read_machine_id "$MACHINE_ID_STORE" 2>/dev/null)" || id=""
		if [ -z "$id" ] && [ -f "$MACHINE_ID_STORE" ]; then
			log_service 'warning: existing machine-id store present but unreadable; ignoring it'
		fi
	fi
	if ! valid_machine_id "$id"; then
		id="$(read_machine_id "$DBUS_MACHINE_ID_FILE" 2>/dev/null)" || id=""
	fi
	if ! valid_machine_id "$id"; then
		id="$(generate_machine_id)"
		valid_machine_id "$id" || {
			log_service 'failed to generate persistent machine-id'
			return 1
		}
	fi

	# 4) Persist the chosen identity. UCI is authoritative; the file store is a
	#    proxy for the binary and any tool that reads /etc/vnt2/machine-id.
	#    The named section is recreated first if the shipped config file is
	#    missing (e.g. after a partial upgrade), otherwise the option write
	#    would fail silently and UCI could never persist the id.
	if [ "$id" != "$uci_id" ]; then
		if [ -z "$(uci -q get "${MACHINE_ID_UCI_PKG}.${MACHINE_ID_UCI_SEC}" 2>/dev/null)" ]; then
			uci -q set "${MACHINE_ID_UCI_PKG}.${MACHINE_ID_UCI_SEC}=${MACHINE_ID_UCI_SEC}" 2>/dev/null
		fi
		uci -q set "${MACHINE_ID_UCI_PKG}.${MACHINE_ID_UCI_SEC}.value=$id" 2>/dev/null
		uci -q commit "${MACHINE_ID_UCI_PKG}" 2>/dev/null ||
			log_service 'failed to persist machine-id to UCI'
	fi

	store_dir="$(dirname "$MACHINE_ID_STORE")"
	if ! mkdir -p "$store_dir"; then
		log_service 'failed to create machine-id store directory'
		return 1
	fi
	tmp="$(mktemp "${MACHINE_ID_STORE}.XXXXXX")" || {
		log_service 'failed to create machine-id store temporary file'
		return 1
	}
	if ! printf '%s\n' "$id" >"$tmp" ||
		! chmod 444 "$tmp" || ! mv -f "$tmp" "$MACHINE_ID_STORE"; then
		rm -f "$tmp"
		log_service 'failed to persist machine-id store; client startup cancelled'
		return 1
	fi

	# 5) Install the id into /etc/machine-id as a regular file. If it is a symlink
	#    OpenWrt placed there, we remove it so the regular file can take its place,
	#    then overwrite only when the content differs to avoid needless churn.
	if [ -L "$MACHINE_ID_FILE" ]; then
		rm -f "$MACHINE_ID_FILE"
	fi
	if [ ! -f "$MACHINE_ID_FILE" ] ||
		[ "$(read_machine_id "$MACHINE_ID_FILE" 2>/dev/null)" != "$id" ]; then
		tmp="$(mktemp "${MACHINE_ID_FILE}.XXXXXX")" || {
			log_service 'failed to create persistent machine-id temporary file'
			return 1
		}
		if ! printf '%s\n' "$id" >"$tmp" ||
			! chmod 444 "$tmp" || ! mv -f "$tmp" "$MACHINE_ID_FILE"; then
			rm -f "$tmp"
			log_service 'failed to persist machine-id; client startup cancelled'
			return 1
		fi
		log_service 'saved machine-id for automatic device identity across reboots'
	fi

	# 6) Keep D-Bus pointed at our persistent id (9.4.4).
	dbus_id="$(read_machine_id "$DBUS_MACHINE_ID_FILE" 2>/dev/null)" || dbus_id=""
	if [ "$dbus_id" != "$id" ]; then
		log_service 'restoring persistent machine-id for automatic device identity'
	fi
	if [ -L "$DBUS_MACHINE_ID_FILE" ] &&
		[ "$(readlink "$DBUS_MACHINE_ID_FILE")" = "$MACHINE_ID_FILE" ]; then
		return 0
	fi
	if ! mkdir -p "$(dirname "$DBUS_MACHINE_ID_FILE")"; then
		log_service 'failed to create D-Bus machine-id directory'
		return 1
	fi
	# A private temporary directory protects the new link from preexisting paths.
	tmp="$(mktemp -d "${DBUS_MACHINE_ID_FILE}.XXXXXX")" || {
		log_service 'failed to create D-Bus machine-id temporary directory'
		return 1
	}
	if ! ln -s "$MACHINE_ID_FILE" "$tmp/id" ||
		! mv -f "$tmp/id" "$DBUS_MACHINE_ID_FILE"; then
		rm -f "$tmp/id"
		rmdir "$tmp"
		log_service 'failed to link D-Bus machine-id; client startup cancelled'
		return 1
	fi
	rmdir "$tmp"
	return 0
}

start_cli_instance() {
	local cfg="$1"
	local enabled cli_bin ctrl_bin ctrl_port log_level

	config_get_bool enabled "$cfg" "enabled" "0"

	# Always refresh the runtime TOML, even while the client is stopped: the
	# config editor reads this file and it must mirror UCI.
	EXPORT_NOT_CONFIGURED=0
	if ! export_client_config "$cfg"; then
		if [ "$enabled" = "1" ] && [ "$EXPORT_NOT_CONFIGURED" = "1" ]; then
			log_service 'client enabled but not configured; start skipped'
			return 0
		fi
		if [ "$enabled" = "1" ]; then
			log_service 'start failed: runtime toml export failed'
			return 1
		fi
		log_service 'client disabled; runtime toml export failed'
		cleanup_network
		return 0
	fi

	if [ "$enabled" != "1" ]; then
		log_service 'not enabled, skip start'
		cleanup_network
		return 0
	fi

	log_service 'start requested'

	cli_bin="$(prepare_binary "$cfg" "vnt2_cli_bin" "/usr/bin/vnt2_cli" "vnt2_cli" "$DOWNLOAD_CLI_STATE" "cli")" || {
		log_service 'start failed: missing executable vnt2_cli'
		return 1
	}

	config_get ctrl_bin "$cfg" "vnt2_ctrl_bin" "/usr/bin/vnt2_ctrl"
	if ! ensure_elf_exec "$ctrl_bin"; then
		log_service 'control tool vnt2_ctrl is missing or invalid; status page will show control info as unavailable'
	fi

	config_get ctrl_port "$cfg" "ctrl_port" "11233"
	ctrl_port="$(trim_value "$ctrl_port")"
	valid_port "$ctrl_port" || ctrl_port="11233"

	config_get log_level "$cfg" "log_level" "info"
	case "$log_level" in
		error|warn|info|debug|trace) : ;;
		*) log_level="info" ;;
	esac

	ensure_persistent_machine_id || return 1

	# Remember the device configuration that matches the runtime TOML so a
	# later restart can tell whether the virtual interface itself is changing.
	local last_mode last_tun
	config_get last_mode "$cfg" "device_mode" "tun"
	config_get last_tun "$cfg" "tun_name" ""
	printf 'old_mode="%s"\nold_tun="%s"\n' "$(trim_value "$last_mode")" "$(trim_value "$last_tun")" >"${LAST_DEVICE_STATE_FILE}" 2>/dev/null || true

	log_service "using ${cli_bin} ctrl=${ctrl_bin} port=${ctrl_port} conf=${TOML_EXPORT_FILE}"
	ensure_client_log_config "$log_level"
	: >"${CLI_STDERR_LOG}" 2>/dev/null || true
	procd_open_instance "vnt2_cli"
	procd_set_param env RUST_LOG="$log_level"
	procd_set_param command /bin/sh -c "cd /tmp && exec \"${cli_bin}\" --conf \"${TOML_EXPORT_FILE}\" --ctrl-port \"${ctrl_port}\" 2>>\"${CLI_STDERR_LOG}\""
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param term_timeout 10
	procd_close_instance
	date +%s >"${CLI_TIME}"
	log_service 'start command submitted'
}


start_service() {
	local cfg rc=0

	ensure_log_files
	log_service 'service start flow begin'
	log_download 'service start flow begin'

	sync_network_command || rc=1

	config_load "${CONF}"
	cfg="$(get_first_section_id "vnt2_cli")"

	if [ -n "$cfg" ]; then
		start_cli_instance "$cfg" || rc=1
	else
		log_service 'vnt2_cli config section not found'
	fi

	log_download "start_service finished rc=${rc}"
	return "$rc"
}

stop_service() {
	ensure_log_files
	log_service 'service stop flow begin'
	log_download 'service stop flow begin'

	rm -f "${CLI_TIME}"
	if [ "${VNT2_RESTART_MODE:-}" = "apply" ]; then
		# Keep the router management path alive while a queued Save & Apply
		# restart replaces the managed processes, unless the virtual network
		# device itself is changing. A stale tun/tap interface from the old
		# configuration would otherwise persist and confuse the restarted
		# client or netifd binding.
		local old_mode="" old_tun="" new_mode="" new_tun="" cleanup=0 cfg=""
		if [ -f "${LAST_DEVICE_STATE_FILE}" ]; then
			. "${LAST_DEVICE_STATE_FILE}"
		fi
		config_load "${CONF}"
		cfg="$(get_first_section_id "vnt2_cli")"
		if [ -n "$cfg" ]; then
			config_get new_mode "$cfg" "device_mode" ""
			config_get new_tun "$cfg" "tun_name" ""
		fi
		new_mode="$(trim_value "$new_mode")"
		new_tun="$(trim_value "$new_tun")"
		[ -n "$new_mode" ] || new_mode="tun"
		[ "${old_mode:-tun}" != "$new_mode" ] && cleanup=1
		[ "${old_tun:-}" != "$new_tun" ] && cleanup=1
		if [ "$cleanup" -eq 1 ]; then
			log_download "device changed (${old_mode:-tun}/${old_tun:-*} → ${new_mode}/${new_tun:-*}), cleaning up old interface"
			cleanup_network
		else
			log_download 'queued apply restart keeps network and firewall state'
		fi
	else
		cleanup_network
	fi

	log_service 'service stopped'
	log_download "service stopped"
}

reload_service() {
	schedule_restart
	return 0
}

schedule_restart() {
	local marker_tmp="${RESTART_PENDING_FILE}.$$"

	# This path runs inside LuCI/procd reload requests. It must only write a
	# marker; the separately managed vnt2-worker owns every slow operation.
	if (umask 077; printf '%s\n' "$(date +%s)" >"${marker_tmp}"); then
		mv -f "${marker_tmp}" "${RESTART_PENDING_FILE}" >/dev/null 2>&1 || {
			rm -f "${marker_tmp}"
			return 1
		}
	else
		rm -f "${marker_tmp}"
		return 1
	fi
	return 0
}

service_triggers() {
	procd_add_reload_trigger "${CONF}"
}

